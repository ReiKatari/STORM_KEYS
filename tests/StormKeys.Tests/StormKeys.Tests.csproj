<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Models\**\*.cs" Link="Models\%(RecursiveDir)%(FileName)%(Extension)" />
    <Compile Include="..\..\Services\**\*.cs" Link="Services\%(RecursiveDir)%(FileName)%(Extension)" />
    <Compile Include="..\..\Helpers\**\*.cs" Link="Helpers\%(RecursiveDir)%(FileName)%(Extension)" />
  </ItemGroup>

</Project>
