<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StormKeys.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:StormKeys"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{x:Bind ViewModel.CurrentBackgroundBrush, Mode=OneWay}">
        <!-- ОСНОВНАЯ ОБЛАСТЬ ПРИЛОЖЕНИЯ (КОГДА РАЗБЛОКИРОВАНО) -->
        <Grid Visibility="{x:Bind InvBoolToVis(ViewModel.IsVaultLocked), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Верхняя панель команд и навигации -->
            <Border
                Grid.Row="0"
                Padding="24,12,24,12"
                Background="{x:Bind ViewModel.CurrentHeaderBrush, Mode=OneWay}"
                BorderBrush="{x:Bind ViewModel.CurrentCardStrokeBrush, Mode=OneWay}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Логотип и Бренд -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Grid Width="38" Height="38">
                            <Border
                                Width="38"
                                Height="38"
                                CornerRadius="10"
                                Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                Opacity="0.22" />
                            <Image
                                Width="34"
                                Height="34"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="ms-appx:///Assets/Square44x44Logo.scale-200.png"
                                Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="{x:Bind ViewModel.UiTitle, Mode=OneWay}"
                                    Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                                <Border
                                    Padding="6,1,6,1"
                                    Background="#26107C41"
                                    BorderBrush="#107C41"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="#107C41"
                                        Text="CERTIFIED" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{x:Bind ViewModel.CurrentTextSecondaryBrush, Mode=OneWay}"
                                Text="{x:Bind ViewModel.UiSubtitle, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Строка поиска (Ctrl+Shift+Space / Enter — мгновенный авто-ввод первого результата) -->
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        MaxWidth="460"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        PlaceholderText="{x:Bind ViewModel.UiSearchPlaceholder, Mode=OneWay}"
                        QueryIcon="Find"
                        QuerySubmitted="SearchBox_QuerySubmitted"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Кнопки быстрых действий -->
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button
                            Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                            Click="AddEntry_Click"
                            Foreground="#FFFFFF"
                            ToolTipService.ToolTip="Добавить новую запись вручную (Ctrl+N)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.UiAdd, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <Button
                            Click="ImportClipboard_Click"
                            ToolTipService.ToolTip="Быстрая вставка данных из буфера обмена: логин:пароль, ключ, .env, otpauth:// (Ctrl+V)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE77F;" />
                                <TextBlock FontWeight="SemiBold" Text="Вставить" />
                            </StackPanel>
                        </Button>

                        <Button Click="ImportMenu_Click" ToolTipService.ToolTip="{x:Bind ViewModel.UiTooltipImport, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B5;" />
                                <TextBlock Text="{x:Bind ViewModel.UiImport, Mode=OneWay}" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="ImportFile_Click" Text="Импорт из файла (CSV / JSON / KeePass XML / .stormbackup / .env / .txt)">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8E5;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="ImportClipboard_Click" Text="Быстрая вставка из буфера (Ctrl+V)">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE77F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button Click="ExportMenu_Click" ToolTipService.ToolTip="{x:Bind ViewModel.UiTooltipExport, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEDE1;" />
                                <TextBlock Text="{x:Bind ViewModel.UiExport, Mode=OneWay}" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="ExportStormBackup_Click" Text="Зашифрованный архив (.stormbackup AES-256)" />
                                    <MenuFlyoutItem Click="ExportDotEnv_Click" Text="Экспорт ключей в .env файл (DevOps)" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="ExportCsv_Click" Text="Экспорт в CSV" />
                                    <MenuFlyoutItem Click="ExportJson_Click" Text="Экспорт в JSON" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="ExportRecoveryKit_Click" Text="Аварийный лист восстановления (.txt)" />
                                    <MenuFlyoutItem Click="ExportHtml_Click" Text="Печатный резервный паспорт (.html)" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.DeduplicateVaultCommand}" Text="Очистить полные дубликаты в корзину" />
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.NormalizeUrlsCommand}" Text="Нормализовать URL и удалить трекеры" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button Command="{x:Bind ViewModel.ToggleHealthDashboardCommand}" ToolTipService.ToolTip="Интерактивный Центр аудита безопасности и авто-усиления паролей">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9D9;" Foreground="#10B981" />
                        </Button>

                        <Button Command="{x:Bind ViewModel.ToggleMiniModeCommand}" ToolTipService.ToolTip="Компактный плавающий режим «Поверх всех окон» (Always-on-Top Mini Mode)">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEE49;" />
                        </Button>

                        <Button Click="ToggleDensity_Click" ToolTipService.ToolTip="Переключить компактный / комфортный вид карточек">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A9;" />
                        </Button>

                        <Button Command="{x:Bind ViewModel.SyncCloudCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.CloudSyncStatusText, Mode=OneWay}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE753;" />
                        </Button>

                        <Button Click="OpenSettings_Click" ToolTipService.ToolTip="{x:Bind ViewModel.UiTooltipSettings, Mode=OneWay}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                        </Button>

                        <Button Command="{x:Bind ViewModel.LockVaultCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.UiTooltipLock, Mode=OneWay}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72E;" />
                        </Button>

                        <Button Command="{x:Bind ViewModel.TriggerEmergencyPanicLockCommand}" ToolTipService.ToolTip="Тревожная кнопка экстренной блокировки и очистки буфера (Ctrl+Shift+L)">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7BA;" Foreground="#D13438" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Сводные метрические карточки и индекс безопасности -->
            <StackPanel Grid.Row="1" Margin="24,12,24,4" Spacing="8">
                <!-- Идея #1: Баннер мгновенного авто-ввода для распознанного активного окна -->
                <Border
                    Padding="12,6"
                    Background="#2210B981"
                    BorderBrush="#10B981"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind BoolToVis(ViewModel.HasMatchedWindowEntry), Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" Foreground="#10B981" FontSize="14" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.MatchedWindowBannerText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Column="2"
                            Padding="10,4"
                            Background="#10B981"
                            Command="{x:Bind ViewModel.AutoTypeMatchedWindowCommand}"
                            Foreground="#FFFFFF">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="11" />
                                <TextBlock FontSize="11.5" FontWeight="Bold" Text="Авто-ввод в окно" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Всего записей -->
                    <Border
                        Grid.Column="0"
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.UiTotalKeys, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Text="{x:Bind ViewModel.TotalEntriesCount, Mode=OneWay}" />
                            </StackPanel>
                            <FontIcon
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="24"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE8D7;"
                                Opacity="0.7" />
                        </Grid>
                    </Border>

                    <!-- Истекающие скоро (<= 30 дней) -->
                    <Border
                        Grid.Column="1"
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.UiExpiringSoon, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="#FF8C00"
                                    Text="{x:Bind ViewModel.ExpiringSoonCount, Mode=OneWay}" />
                            </StackPanel>
                            <FontIcon
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="24"
                                Foreground="#FF8C00"
                                Glyph="&#xE7BA;"
                                Opacity="0.8" />
                        </Grid>
                    </Border>

                    <!-- Истёкшие -->
                    <Border
                        Grid.Column="2"
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.UiExpiredLicenses, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="#D13438"
                                    Text="{x:Bind ViewModel.ExpiredCount, Mode=OneWay}" />
                            </StackPanel>
                            <FontIcon
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="24"
                                Foreground="#D13438"
                                Glyph="&#xEA39;"
                                Opacity="0.8" />
                        </Grid>
                    </Border>

                    <!-- Облако / Хранилище -->
                    <Border
                        Grid.Column="3"
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.UiSyncStatus, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.CloudSyncStatusText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="24"
                                Foreground="#0078D4"
                                Glyph="&#xE753;"
                                Opacity="0.8" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ДИНАМИЧЕСКИЙ ГРАФИК ЗДОРОВЬЯ ХРАНИЛИЩА (LIVE DYNAMIC HEALTH GAUGE + ЦЕНТР АУДИТА) -->
                <Border
                    Padding="16,8"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9D9;" FontSize="14" Foreground="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Индекс безопасности:" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                            <TextBlock FontSize="12" FontWeight="Bold" Text="{x:Bind ViewModel.HealthScoreText, Mode=OneWay}" Foreground="#107C41" />
                        </StackPanel>

                        <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                            <ProgressBar
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Maximum="1.0"
                                Value="{x:Bind ViewModel.ActiveRatio, Mode=OneWay}"
                                Foreground="#107C41" />
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="8" Height="8" Fill="#107C41" />
                                <TextBlock FontSize="11" Text="Активные" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="8" Height="8" Fill="#FF8C00" />
                                <TextBlock FontSize="11" Text="Истекающие" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="8" Height="8" Fill="#D13438" />
                                <TextBlock FontSize="11" Text="Истёкшие" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Button
                            Grid.Column="3"
                            Padding="8,3"
                            Command="{x:Bind ViewModel.ToggleHealthDashboardCommand}"
                            Content="Центр аудита"
                            FontSize="11"
                            FontWeight="SemiBold" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 3. Фильтры категорий, сроков, сортировки и быстрые чипы -->
            <StackPanel Grid.Row="2" Margin="24,4,24,4" Spacing="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Grid.Column="0"
                        ItemsSource="{x:Bind CategoryFilterOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedCategoryFilter, Mode=TwoWay}" />

                    <ComboBox
                        Grid.Column="1"
                        ItemsSource="{x:Bind ExpirationFilterOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedExpirationFilter, Mode=TwoWay}" />

                    <ComboBox
                        Grid.Column="2"
                        ItemsSource="{x:Bind SortOrderOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedSortOrder, Mode=TwoWay}"
                        ToolTipService.ToolTip="Режим сортировки записей" />

                    <Button
                        Grid.Column="3"
                        Command="{x:Bind ViewModel.UndoDeleteCommand}"
                        Visibility="{x:Bind BoolToVis(ViewModel.CanUndoDelete), Mode=OneWay}"
                        ToolTipService.ToolTip="Восстановить последнюю удалённую запись (Ctrl+Z)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" FontSize="12" />
                            <TextBlock Text="Вернуть удалённую" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="4"
                        Command="{x:Bind ViewModel.AutoStrengthenWeakPasswordsCommand}"
                        ToolTipService.ToolTip="Пакетное усиление всех слабых паролей в 1 клик (старые сохранятся в историю)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="12" Foreground="#10B981" />
                            <TextBlock Text="Усилить слабые" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Информационное сообщение -->
                    <InfoBar
                        Grid.Column="5"
                        IsClosable="True"
                        IsOpen="{x:Bind HasText(ViewModel.StatusMessage), Mode=OneWay}"
                        Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Severity="Informational" />
                </Grid>

                <!-- Быстрые чипы категорий и статусов (компактная посадка + защитный отступ 18px от полосы прокрутки) -->
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel Margin="2,2,2,18" Orientation="Horizontal" Spacing="5">
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="All" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Все" FontWeight="SemiBold" FontSize="11.5" />
                                <Border Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" CornerRadius="10" Padding="5,1">
                                    <TextBlock Text="{x:Bind ViewModel.TotalEntriesCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="Favorites" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE735;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FFB900" />
                                <TextBlock Text="Избранное" FontWeight="SemiBold" FontSize="11.5" />
                                <Border Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" CornerRadius="10" Padding="5,1">
                                    <TextBlock Text="{x:Bind ViewModel.FavoritesCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="Account" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                <TextBlock Text="Аккаунты" FontWeight="SemiBold" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="License" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                <TextBlock Text="Лицензии" FontWeight="SemiBold" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="ApiKey" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE943;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                <TextBlock Text="API / Токены" FontWeight="SemiBold" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="Server" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                <TextBlock Text="Серверы / RDP" FontWeight="SemiBold" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="BankCard" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8C7;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                <TextBlock Text="Карты" FontWeight="SemiBold" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="Wifi" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE701;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                <TextBlock Text="Wi-Fi" FontWeight="SemiBold" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="Crypto" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8AC;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                <TextBlock Text="Крипто" FontWeight="SemiBold" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="Breached" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#D13438" />
                                <TextBlock Text="В утечках" FontWeight="SemiBold" FontSize="11.5" Foreground="#D13438" />
                                <Border Background="#25D13438" CornerRadius="10" Padding="5,1">
                                    <TextBlock Text="{x:Bind ViewModel.BreachedCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#D13438" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="Weak" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FF8C00" />
                                <TextBlock Text="Слабые" FontWeight="SemiBold" FontSize="11.5" />
                                <Border Background="#25FF8C00" CornerRadius="10" Padding="5,1">
                                    <TextBlock Text="{x:Bind ViewModel.WeakPasswordsCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#FF8C00" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="Duplicates" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FF8C00" />
                                <TextBlock Text="Дубликаты" FontWeight="SemiBold" FontSize="11.5" />
                                <Border Background="#25FF8C00" CornerRadius="10" Padding="5,1">
                                    <TextBlock Text="{x:Bind ViewModel.DuplicatePasswordsCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#FF8C00" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="Expiring" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FF8C00" />
                                <TextBlock Text="Истекающие" FontWeight="SemiBold" FontSize="11.5" />
                                <Border Background="#25FF8C00" CornerRadius="10" Padding="5,1">
                                    <TextBlock Text="{x:Bind ViewModel.ExpiringSoonCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#FF8C00" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="Missing2FA" CornerRadius="14" ToolTipService.ToolTip="Критически важные сервисы без подключённой двухфакторной защиты 2FA">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8D7;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#A855F7" />
                                <TextBlock Text="Без 2FA" FontWeight="SemiBold" FontSize="11.5" />
                                <Border Background="#25A855F7" CornerRadius="10" Padding="5,1">
                                    <TextBlock Text="{x:Bind ViewModel.Missing2FaCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#C084FC" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="Old" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                <TextBlock Text="Старые (&gt;1г)" FontWeight="SemiBold" FontSize="11.5" />
                                <Border Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" CornerRadius="10" Padding="5,1">
                                    <TextBlock Text="{x:Bind ViewModel.OldPasswordsCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Padding="8,4" Click="FilterChip_Click" Tag="Trash" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#D13438" />
                                <TextBlock Text="Корзина" FontWeight="SemiBold" FontSize="11.5" />
                                <Border Background="#25D13438" CornerRadius="10" Padding="5,1">
                                    <TextBlock Text="{x:Bind ViewModel.TrashCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#D13438" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <!-- 4А. ИНТЕРАКТИВНАЯ ПАНЕЛЬ БЫСТРОГО СТАРТА (КОГДА ХРАНИЛИЩЕ ПУСТОЕ — 0% ОБРЕЗАННОГО ТЕКСТА) -->
            <ScrollViewer
                Grid.Row="3"
                Padding="24,4,12,24"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind BoolToVis(ViewModel.IsVaultEmpty), Mode=OneWay}">
                <Border
                    Margin="0,0,18,0"
                    Padding="28,26"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="18">
                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="36"
                                Foreground="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                Glyph="&#xE8D7;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="Как добавить ключи, пароли и 2FA в хранилище"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Выберите любой удобный способ: ручное создание по шаблону (Ctrl+N), умная вставка из буфера (Ctrl+V) или импорт файла."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Главные кнопки создания и вставки (без обрезания краёв при любом разрешении) -->
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                            <Button
                                Padding="16,10"
                                Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                Click="AddEntry_Click"
                                Foreground="#FFFFFF">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" />
                                    <TextBlock FontWeight="Bold" Text="Добавить запись вручную (Ctrl+N)" />
                                </StackPanel>
                            </Button>

                            <Button
                                Padding="14,10"
                                Click="ImportClipboard_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE77F;" />
                                    <TextBlock FontWeight="SemiBold" Text="Быстрая вставка из буфера (Ctrl+V)" />
                                </StackPanel>
                            </Button>

                            <Button
                                Padding="14,10"
                                Click="ImportFile_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E5;" />
                                    <TextBlock FontWeight="SemiBold" Text="Импорт из файла (CSV / JSON / XML / .env)" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Быстрые шаблоны форматов в 2 сбалансированных ряда (100% кнопок видны сразу без обрезания) -->
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Или создайте запись сразу по готовому шаблону формата:"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />

                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <Button Padding="12,7" Click="QuickAddTemplate_Click" Tag="Account">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE77B;" />
                                        <TextBlock Text="Сайт / Аккаунт + 2FA" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="12,7" Click="QuickAddTemplate_Click" Tag="License">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8A7;" />
                                        <TextBlock Text="Лицензия ПО / Игры" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="12,7" Click="QuickAddTemplate_Click" Tag="ApiKey">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE943;" />
                                        <TextBlock Text="API Ключ / Токен" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="12,7" Click="QuickAddTemplate_Click" Tag="Server">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xEDA2;" />
                                        <TextBlock Text="Сервер / SSH / RDP" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <Button Padding="12,7" Click="QuickAddTemplate_Click" Tag="BankCard">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8C7;" />
                                        <TextBlock Text="Банковская карта" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="12,7" Click="QuickAddTemplate_Click" Tag="Wifi">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE701;" />
                                        <TextBlock Text="Сеть Wi-Fi" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="12,7" Click="QuickAddTemplate_Click" Tag="Crypto">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8AC;" />
                                        <TextBlock Text="Крипто / Seed-фраза" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- 4Б. Список карточек ключей и паролей (с правым отступом 18px от вертикальной полосы прокрутки и Drag & Drop) -->
            <ListView
                Grid.Row="3"
                Padding="24,0,12,24"
                ItemsSource="{x:Bind ViewModel.FilteredEntries, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind InvBoolToVis(ViewModel.IsVaultEmpty), Mode=OneWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,18,0"
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Кастомная или категориальная иконка -->
                                <Border
                                    Grid.Column="0"
                                    Width="42"
                                    Height="42"
                                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                    CornerRadius="8">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="19"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                        Glyph="{Binding EffectiveGlyph}" />
                                </Border>

                                <!-- Название и целевой сервис/приложение (без обрезания текста) -->
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding TargetAppOrUrl}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                        Text="{Binding TagsDisplayText}"
                                        Visibility="{Binding TagsVisibility}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Логин / Email с кнопкой быстрого копирования и Drag & Drop -->
                                <Grid
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    CanDrag="True"
                                    DragStarting="CardUsername_DragStarting"
                                    Tag="{Binding}"
                                    ToolTipService.ToolTip="Перетащите мышью (Drag &amp; Drop) логин в браузер или нажмите копировать"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{Binding UsernameOrEmail}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Grid.Column="1"
                                        Padding="6,4"
                                        VerticalAlignment="Center"
                                        Click="CopyUsername_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="{Binding ElementName=RootPage, Path=ViewModel.UiTooltipCopyUsername}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="12"
                                            Glyph="&#xE8C8;" />
                                    </Button>
                                </Grid>

                                <!-- Секрет (Пароль/Ключ), 2FA TOTP, Банковская карта, Wi-Fi и Срок действия -->
                                <StackPanel
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                                    <Grid ColumnSpacing="6" CanDrag="True" DragStarting="CardSecret_DragStarting" Tag="{Binding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Text="{Binding DisplayedSecret}"
                                            ToolTipService.ToolTip="Перетащите мышью (Drag &amp; Drop) секрет/пароль в нужное поле"
                                            TextWrapping="Wrap" />
                                        <Button
                                            Grid.Column="1"
                                            Padding="6,4"
                                            VerticalAlignment="Center"
                                            Click="PeekSecret_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Показать / скрыть секрет на 5 сек.">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="12"
                                                Glyph="{Binding PeekGlyph}" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Padding="6,4"
                                            VerticalAlignment="Center"
                                            Click="CopySecret_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="{Binding ElementName=RootPage, Path=ViewModel.UiTooltipCopyPassword}">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="12"
                                                Glyph="&#xE8C8;" />
                                        </Button>
                                    </Grid>

                                    <!-- 2FA / TOTP Код с живым 30-секундным таймером, умным ожиданием, авто-вводом и QR-кодом -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding TotpVisibility}">
                                        <Border
                                            CanDrag="True"
                                            DragStarting="CardTotp_DragStarting"
                                            Tag="{Binding}"
                                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            ToolTipService.ToolTip="Перетащите 6-значный 2FA-код в окно браузера">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon
                                                    Glyph="&#xE8D7;"
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock
                                                    Text="{Binding FormattedTotpCode}"
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock
                                                    Text="{Binding TotpCountdownText}"
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Button
                                            Padding="5,3"
                                            Click="CopyTotp_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Скопировать 2FA-код (с умным ожиданием нового окна при остатке &lt;= 3 сек.)">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="11"
                                                Glyph="&#xE8C8;" />
                                        </Button>
                                        <Button
                                            Padding="5,3"
                                            Click="AutoTypeTotp_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Быстро ввести код 2FA в активное окно браузера/программы">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="11"
                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                Glyph="&#xE945;" />
                                        </Button>
                                        <Button
                                            Padding="5,3"
                                            Click="ShowTotpQrFromCard_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Показать QR-код 2FA для сканирования камерой смартфона">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="11"
                                                Glyph="&#xED14;" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Быстрые кнопки Банковской карты (CVV / Срок / PIN) -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding IsBankCardVisibility}">
                                        <Button Padding="6,2" Click="CopyCardCvv_Click" Tag="{Binding}" Content="CVV" FontSize="10" ToolTipService.ToolTip="Скопировать CVV/CVC код карты" />
                                        <Button Padding="6,2" Click="CopyCardExpiry_Click" Tag="{Binding}" Content="Срок" FontSize="10" ToolTipService.ToolTip="Скопировать срок действия карты (MM/YY)" />
                                        <Button Padding="6,2" Click="CopyCardPin_Click" Tag="{Binding}" Content="PIN" FontSize="10" ToolTipService.ToolTip="Скопировать PIN-код карты" />
                                    </StackPanel>

                                    <!-- Быстрые кнопки Wi-Fi (QR-код и Подключение в 1 клик) -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding IsWifiVisibility}">
                                        <Button Padding="6,2" Click="ShowWifiQr_Click" Tag="{Binding}" Content="QR Wi-Fi" FontSize="10" ToolTipService.ToolTip="Показать QR-код для подключения телефона к Wi-Fi" />
                                        <Button Padding="6,2" Click="ConnectWifi_Click" Tag="{Binding}" Content="Подключить ПК" FontSize="10" ToolTipService.ToolTip="Подключить Windows к этой сети Wi-Fi в 1 клик (netsh wlan)" />
                                    </StackPanel>

                                    <!-- Бейджи статуса срока, аудита утечек, резервных кодов и вложений -->
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border
                                            Padding="6,2"
                                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="{Binding ExpirationStatusText}" />
                                        </Border>

                                        <Border
                                            Padding="6,2"
                                            Background="#25D13438"
                                            BorderBrush="#D13438"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{Binding PwnedBreachedVisibility}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#D13438" />
                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#D13438" Text="{Binding PwnedStatusText}" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Padding="6,2"
                                            Background="#25107C41"
                                            BorderBrush="#107C41"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{Binding PwnedSafeVisibility}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#107C41" />
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#107C41" Text="Безопасен" />
                                            </StackPanel>
                                        </Border>

                                        <Button
                                            Padding="5,2"
                                            Click="CopyRecoveryCode_Click"
                                            Tag="{Binding}"
                                            Visibility="{Binding HasRecoveryCodesVisibility}"
                                            ToolTipService.ToolTip="Скопировать и отметить использованным 1 резервный код восстановления 2FA">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding RecoveryCodesBadgeText}" />
                                        </Button>

                                        <Button
                                            Padding="5,2"
                                            Click="ExportAttachment_Click"
                                            Tag="{Binding}"
                                            Visibility="{Binding HasAttachmentsVisibility}"
                                            ToolTipService.ToolTip="Сохранить прикрепленный зашифрованный файл на диск">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding AttachmentsBadgeText}" />
                                        </Button>

                                        <Border
                                            Padding="6,2"
                                            Background="#2538BDF8"
                                            BorderBrush="#38BDF8"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{Binding CardBrandBadgeVisibility}">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" Text="{Binding CardBrandAndLuhnText}" />
                                        </Border>

                                        <Border
                                            Padding="6,2"
                                            Background="#25A855F7"
                                            BorderBrush="#A855F7"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{Binding Missing2FaBadgeVisibility}"
                                            ToolTipService.ToolTip="Рекомендуется включить двухфакторную аутентификацию 2FA (TOTP)">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#C084FC" Text="🛡️ Рекомендуется 2FA" />
                                        </Border>

                                        <Border
                                            Padding="6,2"
                                            Background="#2210B981"
                                            CornerRadius="4"
                                            Visibility="{Binding UsageBadgeVisibility}"
                                            ToolTipService.ToolTip="Количество обращений к секрету">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#34D399" Text="{Binding UsageBadgeText}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Действия: Восстановить из корзины, Авто-вставка, Запуск программы/сайта, Избранное, Дубликат, Сводка, HIBP, Детали, Редактировать, Удалить -->
                                <StackPanel
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <!-- Восстановить из корзины -->
                                    <Button
                                        Padding="8,6"
                                        Click="RestoreFromTrash_Click"
                                        Tag="{Binding}"
                                        Visibility="{Binding IsDeletedVisibility}"
                                        ToolTipService.ToolTip="Восстановить запись из корзины">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="#10B981"
                                            Glyph="&#xE777;" />
                                    </Button>

                                    <!-- Быстрая вставка / Авто-ввод (Макрос {USER}{TAB}{PASS}{ENTER} + 2FA) -->
                                    <Button
                                        Padding="8,6"
                                        Click="QuickAutoType_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Быстрая вставка (Авто-ввод по макросу записи) в предыдущее окно (и скопировать 2FA)">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                            Glyph="&#xE945;" />
                                    </Button>

                                    <!-- Запуск привязанной программы (.exe) или переход на сайт (URL) -->
                                    <Button
                                        Padding="8,6"
                                        Click="LaunchWebsite_Click"
                                        Tag="{Binding}"
                                        Visibility="{Binding HasLaunchTargetVisibility}"
                                        ToolTipService.ToolTip="{Binding LaunchTargetTooltip}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="#10B981"
                                            Glyph="{Binding LaunchTargetGlyph}" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="ToggleFavorite_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="В избранное / Закрепить">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="#FFB900"
                                            Glyph="{Binding FavoriteGlyph}" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="DuplicateEntry_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Дублировать запись (Ctrl+D)">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Glyph="&#xF413;" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="CopySummary_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Скопировать полную сводку карточки">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Glyph="&#xE77F;" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="CheckPwned_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Проверить в базе утечек Have I Been Pwned">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                            Glyph="&#xE72C;" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="ShowCardDetails_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="{Binding ElementName=RootPage, Path=ViewModel.UiTooltipCardDetails}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="#0078D4"
                                            Glyph="&#xE946;" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="EditEntry_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="{Binding ElementName=RootPage, Path=ViewModel.UiTooltipEdit}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Glyph="&#xE70F;" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="DeleteEntry_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Переместить в корзину (или удалить окончательно из корзины)">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="#D13438"
                                            Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- СТИЛИЗОВАННАЯ ПОДСКАЗКА (TEACHING TIP) -->
        <TeachingTip
            x:Name="CardTeachingTip"
            Title="{x:Bind ViewModel.TeachingTipTitle, Mode=OneWay}"
            IsLightDismissEnabled="True"
            IsOpen="{x:Bind ViewModel.IsTeachingTipOpen, Mode=TwoWay}"
            Subtitle="{x:Bind ViewModel.TeachingTipSubtitle, Mode=OneWay}">
            <TeachingTip.Content>
                <StackPanel Margin="0,8,0,0" Spacing="10">
                    <Border
                        Padding="8,4"
                        BorderBrush="{x:Bind HexToBrush(ViewModel.TeachingTipBadgeColor), Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{x:Bind HexToBrush(ViewModel.TeachingTipBadgeColor), Mode=OneWay}"
                            Text="{x:Bind ViewModel.TeachingTipStatus, Mode=OneWay}" />
                    </Border>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Ключ/Пароль надежно сохранен в зашифрованном контейнере." />
                </StackPanel>
            </TeachingTip.Content>
        </TeachingTip>

        <!-- ДИАЛОГ ДОБАВЛЕНИЯ / РЕДАКТИРОВАНИЯ (МАКСИМАЛЬНО ПРОКАЧАННЫЙ В 1.0.5) -->
        <Grid Background="#7F000000" Visibility="{x:Bind BoolToVis(ViewModel.IsEditDialogVisible), Mode=OneWay}">
            <Border
                Width="800"
                MaxHeight="800"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{x:Bind ViewModel.CurrentHeaderBrush, Mode=OneWay}"
                BorderBrush="{x:Bind ViewModel.CurrentCardStrokeBrush, Mode=OneWay}"
                BorderThickness="1"
                CornerRadius="14">
                <ScrollViewer Padding="26,20,12,20">
                    <StackPanel Margin="0,0,18,0" Spacing="14">
                        <!-- Шапка диалога с превью выбранной иконки и кнопкой умного заполнения из буфера -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="42"
                                Height="42"
                                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                BorderBrush="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="20"
                                    Foreground="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                    Glyph="{x:Bind ViewModel.EditPreviewGlyph, Mode=OneWay}" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.EditDialogHeader, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{x:Bind ViewModel.CurrentTextSecondaryBrush, Mode=OneWay}"
                                    Text="Все форматы • Генератор паролей и API-токенов • Живой 2FA + QR • Макросы Авто-ввода • Вложения"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.FillDialogFromClipboardCommand}"
                                ToolTipService.ToolTip="Распознать и заполнить поля из буфера обмена (логин:пароль, otpauth://, .env, ключ ПО, URL)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE77F;" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Из буфера" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 1. Шаблоны всех форматов данных в 2 ряда (100% видны сразу без полосы прокрутки и обрезания) -->
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind ViewModel.CurrentTextSecondaryBrush, Mode=OneWay}"
                                Text="Быстрый шаблон формата записи:" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Padding="11,5" Click="ApplyTemplateInDialog_Click" Tag="Account" Content="Сайт / Аккаунт" FontSize="11" />
                                <Button Padding="11,5" Click="ApplyTemplateInDialog_Click" Tag="License" Content="Лицензия ПО / Игры" FontSize="11" />
                                <Button Padding="11,5" Click="ApplyTemplateInDialog_Click" Tag="ApiKey" Content="API Ключ / Токен" FontSize="11" />
                                <Button Padding="11,5" Click="ApplyTemplateInDialog_Click" Tag="Certificate" Content="SSH / Сертификат" FontSize="11" />
                                <Button Padding="11,5" Click="ApplyTemplateInDialog_Click" Tag="Server" Content="Сервер / БД / RDP" FontSize="11" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Padding="11,5" Click="ApplyTemplateInDialog_Click" Tag="BankCard" Content="Банковская карта" FontSize="11" />
                                <Button Padding="11,5" Click="ApplyTemplateInDialog_Click" Tag="Wifi" Content="Сеть Wi-Fi" FontSize="11" />
                                <Button Padding="11,5" Click="ApplyTemplateInDialog_Click" Tag="Crypto" Content="Крипто / Seed-фраза" FontSize="11" />
                                <Button Padding="11,5" Click="ApplyTemplateInDialog_Click" Tag="Other" Content="Заметка / PIN" FontSize="11" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 2. Выбор иконки записи (20 семантических значков с нижним отступом 16px от скроллбара) -->
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind ViewModel.CurrentTextSecondaryBrush, Mode=OneWay}"
                                Text="Выбор иконки карточки (20 значков):" />
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <ItemsControl Margin="0,2,0,16" ItemsSource="{x:Bind ViewModel.AvailableIcons}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                Click="SelectIcon_Click"
                                                Tag="{Binding Glyph}"
                                                ToolTipService.ToolTip="{Binding Name}">
                                                <FontIcon
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="15"
                                                    Glyph="{Binding Glyph}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- 3. Название и Категория (в 2 колонки) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                Header="Название сервиса, сайта или программы *"
                                PlaceholderText="GitHub, Steam, Windows 11 Pro, Сервер..."
                                Text="{x:Bind ViewModel.EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Header="Категория / Формат"
                                ItemsSource="{x:Bind CategoryEditOptions}"
                                SelectedIndex="{x:Bind EditCategoryIndex, Mode=TwoWay}" />
                        </Grid>

                        <!-- 4. Логин / Email и Привязка к программе (.exe) или сайту (URL) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                Header="Логин, Email, ID или Номер карты"
                                PlaceholderText="user@example.com / admin / root"
                                Text="{x:Bind ViewModel.EditUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox
                                Grid.Column="1"
                                Header="Привязка к сайту (URL) или программе (.exe)"
                                PlaceholderText="https://... или C:\...\app.exe"
                                Text="{x:Bind ViewModel.EditTargetApp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Click="PickTargetApp_Click"
                                ToolTipService.ToolTip="Выбрать локальную программу (.exe, .lnk, .rdp, .bat) для быстрого запуска с карточки">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8E5;" />
                                    <TextBlock FontSize="12" Text="Выбрать .exe" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 5. Пароль / Секретный ключ + Настраиваемый генератор паролей и API-токенов разработчика -->
                        <Border
                            Padding="14,12"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        Grid.Column="0"
                                        Header="Пароль, Токен, Seed-фраза или Лицензионный ключ *"
                                        PlaceholderText="Введите вручную или сгенерируйте по параметрам ниже"
                                        Text="{x:Bind ViewModel.EditSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.GeneratePasswordCommand}"
                                        Foreground="#FFFFFF"
                                        ToolTipService.ToolTip="Сгенерировать пароль по указанным ниже параметрам длины и символов">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8D7;" />
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Пароль" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.GeneratePassphraseCommand}"
                                        ToolTipService.ToolTip="Сгенерировать мнемоническую парольную фразу из 4 слов (Diceware)">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Фраза" />
                                    </Button>

                                    <Button
                                        Grid.Column="3"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.GenerateLicenseKeyCommand}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.UiTooltipGenSoftwareKey, Mode=OneWay}">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Ключ ПО" />
                                    </Button>

                                    <Button
                                        Grid.Column="4"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.GeneratePinCodeCommand}"
                                        ToolTipService.ToolTip="Сгенерировать цифровой PIN-код">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="PIN" />
                                    </Button>
                                </Grid>

                                <!-- Быстрые пресеты генератора API-токенов и ключей разработчика -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="API / Seed:" />
                                    <Button Padding="8,3" Click="GenApiTokenPreset_Click" Tag="Hex256" Content="256-bit HEX" FontSize="11" />
                                    <Button Padding="8,3" Click="GenApiTokenPreset_Click" Tag="Base64" Content="JWT Secret" FontSize="11" />
                                    <Button Padding="8,3" Click="GenApiTokenPreset_Click" Tag="UUID" Content="UUID v4" FontSize="11" />
                                    <Button Padding="8,3" Click="GenApiTokenPreset_Click" Tag="Bearer" Content="Bearer sk_live_..." FontSize="11" />
                                    <Button Padding="8,3" Command="{x:Bind ViewModel.GenerateSeed12Command}" Content="Seed 12" FontSize="11" ToolTipService.ToolTip="Сгенерировать BIP-39 сид-фразу из 12 слов" />
                                    <Button Padding="8,3" Command="{x:Bind ViewModel.GenerateSeed24Command}" Content="Seed 24" FontSize="11" ToolTipService.ToolTip="Сгенерировать BIP-39 сид-фразу из 24 слов" />
                                </StackPanel>
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.PasswordAnatomyText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" Text="{x:Bind ViewModel.CardLuhnLiveText, Mode=OneWay}" TextWrapping="Wrap" />

                                <!-- Настройки параметров генератора паролей: Длина (ползунок + пресеты) и Наборы символов -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="Длина пароля:" />

                                    <Slider
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Minimum="6"
                                        Maximum="64"
                                        StepFrequency="1"
                                        Value="{x:Bind IntToDouble(ViewModel.GenPasswordLength), Mode=OneWay}"
                                        ValueChanged="GenSlider_ValueChanged" />

                                    <Border
                                        Grid.Column="2"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Text="{x:Bind FormatGenLen(ViewModel.GenPasswordLength), Mode=OneWay}" />
                                    </Border>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Padding="6,2" Click="GenLenPreset_Click" Tag="12" Content="12" FontSize="11" />
                                        <Button Padding="6,2" Click="GenLenPreset_Click" Tag="16" Content="16" FontSize="11" />
                                        <Button Padding="6,2" Click="GenLenPreset_Click" Tag="24" Content="24" FontSize="11" />
                                        <Button Padding="6,2" Click="GenLenPreset_Click" Tag="32" Content="32" FontSize="11" />
                                        <Button Padding="6,2" Click="GenLenPreset_Click" Tag="48" Content="48" FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <!-- Чекбоксы классов символов генератора (в 2 ряда без обрезания текста) -->
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <CheckBox MinWidth="0" Content="A–Z (Заглавные)" FontSize="12" IsChecked="{x:Bind ViewModel.GenUseUpper, Mode=TwoWay}" />
                                        <CheckBox MinWidth="0" Content="a–z (Строчные)" FontSize="12" IsChecked="{x:Bind ViewModel.GenUseLower, Mode=TwoWay}" />
                                        <CheckBox MinWidth="0" Content="0–9 (Цифры)" FontSize="12" IsChecked="{x:Bind ViewModel.GenUseDigits, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <CheckBox MinWidth="0" Content="!@#$%^&amp;* (Спецсимволы)" FontSize="12" IsChecked="{x:Bind ViewModel.GenUseSpecial, Mode=TwoWay}" />
                                        <CheckBox MinWidth="0" Content="Без похожих символов (0/O, 1/l)" FontSize="12" IsChecked="{x:Bind ViewModel.GenExcludeAmbiguous, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Индикатор надежности, битовой энтропии и времени взлома -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Надёжность:" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{x:Bind HexToBrush(ViewModel.SecretStrengthColor), Mode=OneWay}"
                                        Text="{x:Bind ViewModel.SecretStrengthLabel, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="• Энтропия:" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.SecretEntropyText, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="• Оценка взлома:" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                        Text="{x:Bind ViewModel.SecretCrackTimeText, Mode=OneWay}" />
                                </StackPanel>

                                <!-- История паролей записи -->
                                <Grid ColumnSpacing="8" Visibility="{x:Bind BoolToVis(ViewModel.HasPasswordHistory), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.EditPasswordHistoryText, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Padding="8,4"
                                        Command="{x:Bind ViewModel.RestorePreviousPasswordCommand}"
                                        Content="Восстановить пред. пароль"
                                        FontSize="11" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 6. Двухфакторная аутентификация (2FA / TOTP) + Сканер буфера + Живая проверка + QR -->
                        <Border
                            Padding="14,12"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        Grid.Column="0"
                                        Header="Двухфакторная аутентификация 2FA (Base32 ключ или ссылка otpauth://totp/...)"
                                        PlaceholderText="Вставьте секретный ключ с сайта (JBSWY3DPEHPK3PXP) или URI otpauth://..."
                                        Text="{x:Bind ViewModel.EditTotpSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.Scan2FaFromClipboardCommand}"
                                        ToolTipService.ToolTip="Извлечь Base32 секрет или otpauth:// ссылку из буфера обмена">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE77F;" />
                                            <TextBlock FontSize="12" Text="Из буфера" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.GenerateTotpSecretCommand}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.UiTotpGenerate, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE72C;" />
                                            <TextBlock FontSize="12" Text="Создать 2FA" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Живое табло прохождения 2FA прямо внутри диалога -->
                                <Border
                                    Padding="12,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="{x:Bind BoolToVis(ViewModel.HasValidEditTotp), Mode=OneWay}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#10B981" Glyph="&#xE73E;" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Foreground="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                                Text="{x:Bind ViewModel.EditTotpLiveCode, Mode=OneWay}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.EditTotpCountdownText, Mode=OneWay}" />
                                            <ProgressBar
                                                Maximum="1.0"
                                                Value="{x:Bind ViewModel.EditTotpProgressRatio, Mode=OneWay}"
                                                Foreground="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}" />
                                        </StackPanel>

                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Command="{x:Bind ViewModel.CopyEditTotpCodeCommand}"
                                            ToolTipService.ToolTip="Скопировать текущий 6-значный код для подтверждения привязки 2FA на сайте">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE8C8;" />
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Копировать 2FA" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Command="{x:Bind ViewModel.ShowEditTotpQrCommand}"
                                            ToolTipService.ToolTip="Показать QR-код для сканирования камерой телефона">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xED14;" />
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="QR-код" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 7. Настраиваемый макрос авто-печати (Auto-Type Sequence) -->
                        <StackPanel Spacing="6">
                            <TextBox
                                Header="Макрос авто-ввода (Auto-Type Sequence)"
                                PlaceholderText="{}{USER}{TAB}{PASS}{ENTER}"
                                Text="{x:Bind ViewModel.EditAutoTypeSequence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Шаблоны макроса:" />
                                <Button Padding="8,3" Click="AutoTypeMacroPreset_Click" Tag="{}{USER}{TAB}{PASS}{ENTER}" Content="Логин + Tab + Пароль + Enter" FontSize="11" />
                                <Button Padding="8,3" Click="AutoTypeMacroPreset_Click" Tag="{}{USER}{TAB}{PASS}{TAB}{TOTP}{ENTER}" Content="+ 2FA Код" FontSize="11" />
                                <Button Padding="8,3" Click="AutoTypeMacroPreset_Click" Tag="{}{PASS}{ENTER}" Content="Только Пароль" FontSize="11" />
                                <Button Padding="8,3" Click="AutoTypeMacroPreset_Click" Tag="{}{TOTP}{ENTER}" Content="Только 2FA" FontSize="11" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 8. Теги и Пользовательские атрибуты (CVV, PIN, Порт, IP, Seed) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                Header="Теги (через запятую)"
                                PlaceholderText="работа, облако, банк, steam..."
                                Text="{x:Bind ViewModel.EditTagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox
                                Grid.Column="1"
                                AcceptsReturn="True"
                                Header="Доп. поля (Ключ: Значение, по 1 на строку)"
                                PlaceholderText="PIN: 1234&#x0a;Порт: 22&#x0a;CVV: 999"
                                Text="{x:Bind ViewModel.EditCustomFieldsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <!-- 9. Сейф резервных кодов восстановления 2FA и Зашифрованные вложения (до 2 МБ) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBox
                                    AcceptsReturn="True"
                                    Header="Резервные коды восстановления 2FA (по 1 в строке)"
                                    PlaceholderText="ABCD-1234&#x0a;EFGH-5678"
                                    Text="{x:Bind ViewModel.EditRecoveryCodesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                                <Button
                                    HorizontalAlignment="Left"
                                    Padding="10,4"
                                    Command="{x:Bind ViewModel.GenerateRecoveryCodesCommand}"
                                    Content="Сгенерировать 8 резервных кодов"
                                    FontSize="11" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Зашифрованные вложения (.pem, .ovpn, .pfx, до 2 МБ)" />
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.EditAttachmentsSummary, Mode=OneWay}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Padding="10,4" Click="AddAttachment_Click" Content="Прикрепить файл..." FontSize="11" />
                                    <Button Padding="10,4" Click="ExportCurrentAttachment_Click" Content="Сохранить..." FontSize="11" Visibility="{x:Bind BoolToVis(ViewModel.HasEditAttachments), Mode=OneWay}" />
                                    <Button Padding="10,4" Command="{x:Bind ViewModel.ClearEditAttachmentsCommand}" Content="Очистить" FontSize="11" Visibility="{x:Bind BoolToVis(ViewModel.HasEditAttachments), Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 10. Срок действия (ExpirationDate) и Заметки -->
                        <StackPanel Spacing="8">
                            <CheckBox Content="Указать конечную дату действия (уведомления за 30, 7, 1 день)" IsChecked="{x:Bind ViewModel.EditHasExpiration, Mode=TwoWay}" />

                            <StackPanel Spacing="8" Visibility="{x:Bind BoolToVis(ViewModel.EditHasExpiration), Mode=OneWay}">
                                <DatePicker HorizontalAlignment="Stretch" Date="{x:Bind EditDatePickerDate, Mode=TwoWay}" />

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Padding="8,4" Click="PresetDays_Click" Content="+30 дней" Tag="30" />
                                    <Button Padding="8,4" Click="PresetDays_Click" Content="+90 дней" Tag="90" />
                                    <Button Padding="8,4" Click="PresetDays_Click" Content="+1 год" Tag="365" />
                                    <Button Padding="8,4" Click="PresetDays_Click" Content="+3 года" Tag="1095" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <TextBox
                            AcceptsReturn="True"
                            Header="Заметки и инструкции"
                            PlaceholderText="Дополнительные примечания или инструкции..."
                            Text="{x:Bind ViewModel.EditNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <!-- Кнопки сохранения/отмены -->
                        <Grid Margin="0,8,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                Command="{x:Bind ViewModel.SaveEntryCommand}"
                                Foreground="#FFFFFF">
                                <TextBlock FontWeight="SemiBold" Text="Сохранить запись" />
                            </Button>

                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Click="CloseEditDialog_Click"
                                Content="Отмена (Esc)" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ДИАЛОГ НАСТРОЕК ХРАНИЛИЩА И ОБЛАКА (МОДАЛЬНЫЙ ОВЕРЛЕЙ 1.0.5) -->
        <Grid Background="#7F000000" Visibility="{x:Bind BoolToVis(ViewModel.IsSettingsDialogVisible), Mode=OneWay}">
            <Border
                Width="680"
                MaxHeight="780"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{x:Bind ViewModel.CurrentHeaderBrush, Mode=OneWay}"
                BorderBrush="{x:Bind ViewModel.CurrentCardStrokeBrush, Mode=OneWay}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer Padding="26,22,12,22">
                    <StackPanel Margin="0,0,18,0" Spacing="14">
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Text="{x:Bind ViewModel.UiSettingsTitle, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />

                        <!-- Локальный путь -->
                        <TextBox
                            Header="{x:Bind ViewModel.UiSettingsLocalVault, Mode=OneWay}"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.SettingsLocalPath, Mode=OneWay}" />

                        <!-- Облачная синхронизация -->
                        <StackPanel Spacing="8">
                            <ToggleSwitch Header="{x:Bind ViewModel.UiSettingsCloudSync, Mode=OneWay}" IsOn="{x:Bind ViewModel.SettingsCloudEnabled, Mode=TwoWay}" />

                            <Grid ColumnSpacing="8" Visibility="{x:Bind BoolToVis(ViewModel.SettingsCloudEnabled), Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    Grid.Column="0"
                                    PlaceholderText="Путь к облачной папке..."
                                    Text="{x:Bind ViewModel.SettingsCloudFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Button
                                    Grid.Column="1"
                                    Click="PickCloudFolder_Click"
                                    Content="Обзор..." />
                            </Grid>
                        </StackPanel>

                        <!-- Оформление STORM AURORA FLUID -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 9 Динамических тем -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.UiSettingsTheme, Mode=OneWay}" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.AvailableThemes}"
                                    SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- 13 Цветов акцентов -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.UiSettingsAccent, Mode=OneWay}" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.AvailableAccents}"
                                    SelectedItem="{x:Bind ViewModel.SelectedAccent, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 11 Языков интерфейса -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.UiSettingsLanguage, Mode=OneWay}" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.AvailableLanguages}"
                                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- 10 Динамических шрифтов -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.UiSettingsFont, Mode=OneWay}" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.AvailableFonts}"
                                    SelectedItem="{x:Bind ViewModel.SelectedFont, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <!-- Автоблокировка -->
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.UiSettingsAutoLock, Mode=OneWay}"
                                Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind AutoLockOptions}"
                                SelectedIndex="{x:Bind AutoLockIndex, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Windows Hello и Анти-скриншот щит (WDA_EXCLUDEFROMCAPTURE) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleSwitch
                                Grid.Column="0"
                                Header="{x:Bind ViewModel.UiWindowsHelloToggle, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.IsWindowsHelloAvailable, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.SettingsWindowsHelloEnabled, Mode=TwoWay}" />
                            <ToggleSwitch
                                Grid.Column="1"
                                Header="Защита от скриншотов и OBS"
                                IsOn="{x:Bind ViewModel.SettingsScreenCaptureProtection, Mode=TwoWay}" />
                        </Grid>

                        <!-- Ключ-файл (.stormkey) и Ложный сейф (Duress Password) -->
                        <Border
                            Padding="12"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Аппаратный Ключ-файл (.stormkey) и Пароль под принуждением (Ложный сейф)" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" PlaceholderText="Ключ-файл (.stormkey) не привязан" Text="{x:Bind ViewModel.SettingsKeyfilePath, Mode=OneWay}" IsReadOnly="True" />
                                    <Button Grid.Column="1" Click="GenerateKeyfile_Click" Content="Создать .stormkey" FontSize="11" />
                                    <Button Grid.Column="2" Click="PickKeyfile_Click" Content="Выбрать..." FontSize="11" />
                                    <Button Grid.Column="3" Command="{x:Bind ViewModel.ClearKeyfileCommand}" Content="Отвязать" FontSize="11" />
                                </Grid>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox Grid.Column="0" PlaceholderText="Задать пароль под принуждением (откроет ложный сейф)" Password="{x:Bind ViewModel.DuressPasswordInput, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.DuressStatusText, Mode=OneWay}" />
                                    <Button Grid.Column="2" Command="{x:Bind ViewModel.SaveDuressPasswordCommand}" Content="Задать" FontSize="11" />
                                    <Button Grid.Column="3" Command="{x:Bind ViewModel.ClearDuressPasswordCommand}" Content="Сброс" FontSize="11" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Аудит скомпрометированных паролей (Have I Been Pwned) -->
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.UiAuditPasswords, Mode=OneWay}" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="{x:Bind ViewModel.CurrentTextSecondaryBrush, Mode=OneWay}" Text="{x:Bind ViewModel.AuditStatusText, Mode=OneWay}" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.AuditAllPasswordsCommand}" IsEnabled="{x:Bind InvBool(ViewModel.IsAuditingPasswords), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                        <TextBlock Text="Проверить" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ProgressBar Value="{x:Bind ViewModel.AuditProgress, Mode=OneWay}" Maximum="100" Visibility="{x:Bind BoolToVis(ViewModel.IsAuditingPasswords), Mode=OneWay}" />
                        </StackPanel>

                        <!-- Смена мастер-пароля, резервное копирование (.bak1..3) и зашифрованный архив (.stormbackup) -->
                        <Border
                            Padding="12"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Смена мастер-пароля, слоты .bak1..3 и зашифрованный бэкап (.stormbackup)" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox Grid.Column="0" PlaceholderText="Текущий пароль" Password="{x:Bind ViewModel.OldMasterPasswordInput, Mode=TwoWay}" />
                                    <PasswordBox Grid.Column="1" PlaceholderText="Новый (мин. 6 симв.)" Password="{x:Bind ViewModel.NewMasterPasswordInput, Mode=TwoWay}" />
                                    <Button Grid.Column="2" Command="{x:Bind ViewModel.ChangeMasterPasswordCommand}" Content="Сменить" />
                                </Grid>
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.BackupSlotsSummaryText, Mode=OneWay}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Padding="8,4" Command="{x:Bind ViewModel.CreateBackupSnapshotCommand}" Content="Создать .bak" FontSize="11" />
                                    <Button Padding="8,4" Click="RestoreBackupSlot_Click" Tag="1" Content="Откат .bak1" FontSize="11" />
                                    <Button Padding="8,4" Click="RestoreBackupSlot_Click" Tag="2" Content="Откат .bak2" FontSize="11" />
                                    <Button Padding="8,4" Click="RestoreBackupSlot_Click" Tag="3" Content="Откат .bak3" FontSize="11" />
                                    <Button Padding="8,4" Click="ExportRecoveryKit_Click" Content="Аварийный лист (.txt)" FontSize="11" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Padding="8,4" Click="ExportEncryptedBackup_Click" Content="Экспорт .stormbackup" FontSize="11" />
                                    <Button Padding="8,4" Click="ImportEncryptedBackup_Click" Content="Импорт .stormbackup" FontSize="11" />
                                    <Button Padding="8,4" Click="ExportDotEnv_Click" Content="Экспорт в .env" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Статус сертификата STORM -->
                        <Border
                            Padding="12"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Foreground="#107C41"
                                    Glyph="&#xE73E;" />
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="#107C41"
                                        Text="{x:Bind ViewModel.CertificateStatus, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Шифрование AES-256-GCM • Хеширование Argon2id • Экосистема STORM" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Автоматическое обновление (Auto-Update System) -->
                        <Border
                            Padding="12"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.UiUpdatesHeader, Mode=OneWay}" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                        IsEnabled="{x:Bind Not(ViewModel.IsCheckingUpdate), Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE895;" />
                                            <TextBlock Text="{x:Bind ViewModel.UiCheckUpdates, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Кнопка Обновить ТОЛЬКО при реально доступной более новой версии -->
                                <StackPanel Spacing="6" Visibility="{x:Bind BoolToVis(ViewModel.IsUpdateAvailable), Mode=OneWay}">
                                    <Button
                                        MinWidth="140"
                                        Padding="16,8"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Command="{x:Bind ViewModel.InstallUpdateCommand}"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" />
                                            <TextBlock Text="Обновить" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Кнопки диалога -->
                        <Grid Margin="0,12,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                Command="{x:Bind ViewModel.SaveSettingsCommand}"
                                Foreground="#FFFFFF"
                                Content="{x:Bind ViewModel.UiSettingsSave, Mode=OneWay}" />

                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Click="CloseSettingsDialog_Click"
                                Content="{x:Bind ViewModel.UiSettingsClose, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ИНТЕРАКТИВНЫЙ ЦЕНТР АУДИТА БЕЗОПАСНОСТИ (SECURITY AUDIT CENTER 1.0.5) -->
        <Grid Background="#7F000000" Visibility="{x:Bind BoolToVis(ViewModel.IsSecurityAuditDialogVisible), Mode=OneWay}">
            <Border
                Width="640"
                MaxHeight="740"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{x:Bind ViewModel.CurrentHeaderBrush, Mode=OneWay}"
                BorderBrush="{x:Bind ViewModel.CurrentCardStrokeBrush, Mode=OneWay}"
                BorderThickness="1"
                CornerRadius="14">
                <ScrollViewer Padding="26,22,12,22">
                    <StackPanel Margin="0,0,18,0" Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}" Glyph="&#xE8D7;" />
                            <TextBlock FontSize="18" FontWeight="Bold" Text="Центр аудита безопасности хранилища" />
                        </StackPanel>
                        <TextBlock
                            FontSize="12"
                            LineHeight="18"
                            Text="{x:Bind ViewModel.SecurityAuditReportText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                Command="{x:Bind ViewModel.FixAllWeakAndDuplicatePasswordsCommand}"
                                Foreground="#FFFFFF"
                                Content="Авто-замена слабых и дублирующихся паролей" />
                            <Button
                                Command="{x:Bind ViewModel.AuditAllPasswordsCommand}"
                                Content="Проверить утечки Have I Been Pwned" />
                            <Button
                                Click="CloseSecurityAuditDialog_Click"
                                Content="Закрыть" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- МОДАЛЬНОЕ ОКНО ВИЗУАЛЬНОГО QR-КОДА (ДЛЯ 2FA И WI-FI НА СМАРТФОН) -->
        <Grid Background="#7F000000" Visibility="{x:Bind BoolToVis(ViewModel.IsQrMatrixDialogVisible), Mode=OneWay}">
            <Border
                Width="460"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{x:Bind ViewModel.CurrentHeaderBrush, Mode=OneWay}"
                BorderBrush="{x:Bind ViewModel.CurrentCardStrokeBrush, Mode=OneWay}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Padding="28" Spacing="14" HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="17"
                        FontWeight="Bold"
                        Text="{x:Bind ViewModel.QrMatrixTitle, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.QrMatrixSubtitle, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border
                        Padding="14"
                        HorizontalAlignment="Center"
                        Background="#FFFFFF"
                        CornerRadius="10">
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            LineHeight="11"
                            Foreground="#000000"
                            Text="{x:Bind ViewModel.QrMatrixArt, Mode=OneWay}" />
                    </Border>
                    <TextBox
                        IsReadOnly="True"
                        FontFamily="Consolas"
                        FontSize="11"
                        Text="{x:Bind ViewModel.QrMatrixRawPayload, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Button
                            Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CopyQrPayloadCommand}"
                            Foreground="#FFFFFF"
                            Content="Скопировать URI" />
                        <Button
                            Click="CloseQrMatrixDialog_Click"
                            Content="Закрыть" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ДИАЛОГ «О ПРОГРАММЕ» STORM KEYS (МОДАЛЬНЫЙ ОВЕРЛЕЙ) -->
        <Grid Background="#7F000000" Visibility="{x:Bind BoolToVis(ViewModel.IsAboutDialogVisible), Mode=OneWay}">
            <Border
                Width="480"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{x:Bind ViewModel.CurrentHeaderBrush, Mode=OneWay}"
                BorderBrush="{x:Bind ViewModel.CurrentCardStrokeBrush, Mode=OneWay}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Padding="32" Spacing="20">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <Grid Width="80" Height="80" HorizontalAlignment="Center">
                            <Border
                                Width="80"
                                Height="80"
                                CornerRadius="22"
                                Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                Opacity="0.25" />
                            <Image
                                Width="72"
                                Height="72"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                                Stretch="UniformToFill" />
                        </Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}"
                            Text="{x:Bind ViewModel.UiAboutTitle, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.UiAboutVersion, Mode=OneWay}" />
                    </StackPanel>

                    <Border
                        Padding="16"
                        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="12"
                                LineHeight="18"
                                TextWrapping="Wrap"
                                Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}"
                                Text="{x:Bind ViewModel.UiAboutDesc, Mode=OneWay}" />

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe Fluent Icons" Foreground="#107C41" Glyph="&#xE73E;" FontSize="14" />
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#107C41"
                                    Text="{x:Bind ViewModel.UiAboutPublisher, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.UiAboutCert, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Button
                        HorizontalAlignment="Stretch"
                        Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                        Click="CloseAboutDialog_Click"
                        Foreground="#FFFFFF"
                        Content="{x:Bind ViewModel.UiAboutClose, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ЭКРАН БЛОКИРОВКИ / АВТОРИЗАЦИИ (ОВЕРЛЕЙ С ИСПРАВЛЕННЫМ WINDOWS HELLO И ВВОДОМ МАСТЕР-ПАРОЛЯ) -->
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="{x:Bind BoolToVis(ViewModel.IsVaultLocked), Mode=OneWay}">
            <Border
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Padding="36" Spacing="20">
                    <Grid Width="72" Height="72" HorizontalAlignment="Center">
                        <Border
                            Width="72"
                            Height="72"
                            CornerRadius="20"
                            Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                            Opacity="0.25" />
                        <Image
                            Width="64"
                            Height="64"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                            Stretch="UniformToFill" />
                    </Grid>

                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="24"
                            FontWeight="Bold"
                            Text="STORM KEYS" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Защищенное хранилище ключей и паролей" />
                    </StackPanel>

                    <!-- Состояние: Первичная настройка (Задать пароль) -->
                    <StackPanel Spacing="12" Visibility="{x:Bind BoolToVis(ViewModel.IsVaultUninitialized), Mode=OneWay}">
                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="Задайте мастер-пароль для инициализации зашифрованного хранилища."
                            Severity="Informational" />

                        <PasswordBox
                            x:Name="NewMasterPasswordBox"
                            Header="Мастер-пароль (минимум 6 символов)"
                            Password="{x:Bind ViewModel.MasterPasswordInput, Mode=TwoWay}"
                            PasswordChanged="UnlockPasswordBox_PasswordChanged"
                            PlaceholderText="Придумайте надежный мастер-пароль" />

                        <PasswordBox
                            x:Name="ConfirmMasterPasswordBox"
                            Header="Подтвердите мастер-пароль"
                            Password="{x:Bind ViewModel.ConfirmPasswordInput, Mode=TwoWay}"
                            PasswordChanged="ConfirmMasterPasswordBox_PasswordChanged"
                            PlaceholderText="Повторите ввод мастер-пароля" />

                        <Button
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Click="CreateVaultButton_Click"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                            <TextBlock FontWeight="SemiBold" Text="Создать хранилище" />
                        </Button>
                    </StackPanel>

                    <!-- Состояние: Разблокировка существующего хранилища -->
                    <StackPanel Spacing="14" Visibility="{x:Bind InvBoolToVis(ViewModel.IsVaultUninitialized), Mode=OneWay}">
                        <PasswordBox
                            x:Name="UnlockPasswordBox"
                            Header="Мастер-пароль"
                            KeyDown="UnlockPasswordBox_KeyDown"
                            Password="{x:Bind ViewModel.MasterPasswordInput, Mode=TwoWay}"
                            PasswordChanged="UnlockPasswordBox_PasswordChanged"
                            PlaceholderText="Введите мастер-пароль для доступа..." />

                        <Button
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Click="UnlockVaultButton_Click"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                            <TextBlock FontWeight="SemiBold" Text="Разблокировать хранилище" />
                        </Button>

                        <!-- Кнопка Windows Hello (биометрия / PIN поверх окна) -->
                        <Button
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            Command="{x:Bind ViewModel.UnlockWithWindowsHelloCommand}"
                            Visibility="{x:Bind BoolToVis(ViewModel.IsWindowsHelloEnrolled), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xE8D7;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="16" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.UiWindowsHelloUnlock, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Ошибка мастер-пароля -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#D13438"
                        Text="{x:Bind ViewModel.MasterPasswordErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind StringToVis(ViewModel.MasterPasswordErrorMessage), Mode=OneWay}" />

                    <!-- Индикатор загрузки -->
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind BoolToVis(ViewModel.IsLoading), Mode=OneWay}" />

                    <!-- Защитный бейдж -->
                    <Border
                        Padding="8,4"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="AES-256-GCM • Argon2id KDF • STORM ECOSYSTEM" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
