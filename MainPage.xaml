<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StormKeys.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:StormKeys"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- ОСНОВНАЯ ОБЛАСТЬ ПРИЛОЖЕНИЯ (КОГДА РАЗБЛОКИРОВАНО) -->
        <Grid Visibility="{x:Bind InvBoolToVis(ViewModel.IsVaultLocked), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Верхняя панель команд и навигации -->
            <Border
                Grid.Row="0"
                Padding="24,12,24,12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Логотип и Бренд -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Border
                            Width="36"
                            Height="36"
                            Background="#0078D4"
                            CornerRadius="8">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                Foreground="White"
                                Glyph="&#xE8D7;" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="STORM KEYS" />
                                <Border
                                    Padding="6,1,6,1"
                                    Background="#26107C41"
                                    BorderBrush="#107C41"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="#107C41"
                                        Text="CERTIFIED" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Менеджер ключей, паролей и лицензий" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Строка поиска -->
                    <AutoSuggestBox
                        Grid.Column="1"
                        MaxWidth="480"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        PlaceholderText="Поиск по названию, логину, сервису или заметкам..."
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Кнопки быстрых действий -->
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Click="AddEntry_Click"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            ToolTipService.ToolTip="Добавить новый ключ или пароль">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" />
                                <TextBlock FontWeight="SemiBold" Text="Добавить" />
                            </StackPanel>
                        </Button>

                        <Button Click="ImportMenu_Click" ToolTipService.ToolTip="Импорт ключей и паролей">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B5;" />
                                <TextBlock Text="Импорт" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="ImportFile_Click" Text="Импорт из файла (CSV / JSON)">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8E5;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="ImportClipboard_Click" Text="Быстрый импорт из буфера">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE77F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button Click="ExportMenu_Click" ToolTipService.ToolTip="Экспорт хранилища">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEDE1;" />
                                <TextBlock Text="Экспорт" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="ExportCsv_Click" Text="Экспорт в CSV" />
                                    <MenuFlyoutItem Click="ExportJson_Click" Text="Экспорт в JSON" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button Command="{x:Bind ViewModel.SyncCloudCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.CloudSyncStatusText, Mode=OneWay}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE753;" />
                        </Button>

                        <Button Click="OpenSettings_Click" ToolTipService.ToolTip="Настройки хранилища и облака">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                        </Button>

                        <Button Command="{x:Bind ViewModel.LockVaultCommand}" ToolTipService.ToolTip="Заблокировать хранилище (Ctrl+L)">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72E;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Сводные метрические карточки (Метрики сроков и статуса) -->
            <Grid
                Grid.Row="1"
                Margin="24,16,24,8"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Всего записей -->
                <Border
                    Grid.Column="0"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Всего ключей и паролей" />
                            <TextBlock
                                FontSize="22"
                                FontWeight="Bold"
                                Text="{x:Bind ViewModel.TotalEntriesCount, Mode=OneWay}" />
                        </StackPanel>
                        <FontIcon
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="24"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE8D7;"
                            Opacity="0.7" />
                    </Grid>
                </Border>

                <!-- Истекающие скоро (<= 30 дней) -->
                <Border
                    Grid.Column="1"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Истекают скоро (≤30 дн.)" />
                            <TextBlock
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="#FF8C00"
                                Text="{x:Bind ViewModel.ExpiringSoonCount, Mode=OneWay}" />
                        </StackPanel>
                        <FontIcon
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="24"
                            Foreground="#FF8C00"
                            Glyph="&#xE7BA;"
                            Opacity="0.8" />
                    </Grid>
                </Border>

                <!-- Истёкшие -->
                <Border
                    Grid.Column="2"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Истёкшие лицензии" />
                            <TextBlock
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="#D13438"
                                Text="{x:Bind ViewModel.ExpiredCount, Mode=OneWay}" />
                        </StackPanel>
                        <FontIcon
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="24"
                            Foreground="#D13438"
                            Glyph="&#xEA39;"
                            Opacity="0.8" />
                    </Grid>
                </Border>

                <!-- Облако / Хранилище -->
                <Border
                    Grid.Column="3"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Статус синхронизации" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.CloudSyncStatusText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <FontIcon
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="24"
                            Foreground="#0078D4"
                            Glyph="&#xE753;"
                            Opacity="0.8" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Фильтры категорий и сроков + статусное сообщение -->
            <Grid
                Grid.Row="2"
                Margin="24,8,24,12"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    ItemsSource="{x:Bind CategoryFilterOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedCategoryFilter, Mode=TwoWay}" />

                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{x:Bind ExpirationFilterOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedExpirationFilter, Mode=TwoWay}" />

                <!-- Информационное сообщение -->
                <InfoBar
                    Grid.Column="2"
                    IsClosable="True"
                    IsOpen="{x:Bind HasText(ViewModel.StatusMessage), Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="Informational" />
            </Grid>

            <!-- 4. Список карточек ключей и паролей -->
            <ListView
                Grid.Row="3"
                Padding="24,0,24,24"
                ItemsSource="{x:Bind ViewModel.FilteredEntries, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Иконка категории -->
                                <Border
                                    Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                    CornerRadius="6">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                        Glyph="{Binding CategoryGlyph}" />
                                </Border>

                                <!-- Название и целевой сервис/приложение -->
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding TargetAppOrUrl}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Логин / Email с кнопкой быстрого копирования -->
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        MaxWidth="160"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{Binding UsernameOrEmail}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Padding="6,4"
                                        Click="CopyUsername_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Скопировать логин">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="12"
                                            Glyph="&#xE8C8;" />
                                    </Button>
                                </StackPanel>

                                <!-- Секрет (Пароль/Ключ) и Срок действия -->
                                <StackPanel
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Text="{Binding MaskedSecret}" />
                                        <Button
                                            Padding="6,4"
                                            Click="CopySecret_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Скопировать пароль/ключ (буфер очистится автоматически)">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="12"
                                                Glyph="&#xE8C8;" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Статус срока действия -->
                                    <Border
                                        HorizontalAlignment="Left"
                                        Padding="6,2"
                                        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="{Binding ExpirationStatusText}" />
                                    </Border>
                                </StackPanel>

                                <!-- Действия: Подсказка, Редактировать, Удалить -->
                                <StackPanel
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <!-- Стилизованная подсказка (TeachingTip) -->
                                    <Button
                                        Padding="8,6"
                                        Click="ShowCardDetails_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Стилизованная подсказка и детали">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="#0078D4"
                                            Glyph="&#xE946;" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="EditEntry_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Редактировать">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Glyph="&#xE70F;" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="DeleteEntry_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Удалить">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="#D13438"
                                            Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- СТИЛИЗОВАННАЯ ПОДСКАЗКА (TEACHING TIP) -->
        <TeachingTip
            x:Name="CardTeachingTip"
            Title="{x:Bind ViewModel.TeachingTipTitle, Mode=OneWay}"
            IsLightDismissEnabled="True"
            IsOpen="{x:Bind ViewModel.IsTeachingTipOpen, Mode=TwoWay}"
            Subtitle="{x:Bind ViewModel.TeachingTipSubtitle, Mode=OneWay}">
            <TeachingTip.Content>
                <StackPanel Margin="0,8,0,0" Spacing="10">
                    <Border
                        Padding="8,4"
                        BorderBrush="{x:Bind HexToBrush(ViewModel.TeachingTipBadgeColor), Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{x:Bind HexToBrush(ViewModel.TeachingTipBadgeColor), Mode=OneWay}"
                            Text="{x:Bind ViewModel.TeachingTipStatus, Mode=OneWay}" />
                    </Border>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Ключ/Пароль надежно сохранен в зашифрованном контейнере." />
                </StackPanel>
            </TeachingTip.Content>
        </TeachingTip>

        <!-- ДИАЛОГ ДОБАВЛЕНИЯ / РЕДАКТИРОВАНИЯ (МОДАЛЬНЫЙ ОВЕРЛЕЙ) -->
        <Grid Background="#7F000000" Visibility="{x:Bind BoolToVis(ViewModel.IsEditDialogVisible), Mode=OneWay}">
            <Border
                Width="540"
                MaxHeight="700"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer Padding="28">
                    <StackPanel Spacing="16">
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Text="{x:Bind ViewModel.EditDialogHeader, Mode=OneWay}" />

                        <!-- Название -->
                        <TextBox
                            Header="Название сервиса или программы *"
                            PlaceholderText="Например: GitHub Pro, Office 365, Лицензия Windows..."
                            Text="{x:Bind ViewModel.EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Категория -->
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            Header="Категория"
                            ItemsSource="{x:Bind CategoryEditOptions}"
                            SelectedIndex="{x:Bind EditCategoryIndex, Mode=TwoWay}" />

                        <!-- Логин / Email -->
                        <TextBox
                            Header="Логин, Email или Имя пользователя"
                            PlaceholderText="user@example.com или admin"
                            Text="{x:Bind ViewModel.EditUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Секрет (Пароль или Лицензионный ключ) -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                Header="Пароль или Лицензионный ключ *"
                                PlaceholderText="Введите пароль или сгенерируйте"
                                Text="{x:Bind ViewModel.EditSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.GeneratePasswordCommand}"
                                ToolTipService.ToolTip="Сгенерировать надежный пароль">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D7;" />
                            </Button>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.GenerateLicenseKeyCommand}"
                                ToolTipService.ToolTip="Сгенерировать формат ключа ПО (XXXXX-XXXXX...)">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" />
                            </Button>
                        </Grid>

                        <!-- Индикатор надежности пароля -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Надежность:" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{x:Bind HexToBrush(ViewModel.SecretStrengthColor), Mode=OneWay}"
                                Text="{x:Bind ViewModel.SecretStrengthLabel, Mode=OneWay}" />
                        </StackPanel>

                        <!-- URL или программа -->
                        <TextBox
                            Header="Ссылка или название программы"
                            PlaceholderText="https://... или Имя приложения"
                            Text="{x:Bind ViewModel.EditTargetApp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Срок действия (ExpirationDate) -->
                        <StackPanel Spacing="8">
                            <CheckBox Content="Указать конечную дату действия (уведомления за 30, 7, 1 день)" IsChecked="{x:Bind ViewModel.EditHasExpiration, Mode=TwoWay}" />

                            <StackPanel Spacing="8" Visibility="{x:Bind BoolToVis(ViewModel.EditHasExpiration), Mode=OneWay}">
                                <DatePicker HorizontalAlignment="Stretch" Date="{x:Bind EditDatePickerDate, Mode=TwoWay}" />

                                <!-- Пресеты сроков -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button
                                        Padding="8,4"
                                        Click="PresetDays_Click"
                                        Content="+30 дней"
                                        Tag="30" />
                                    <Button
                                        Padding="8,4"
                                        Click="PresetDays_Click"
                                        Content="+90 дней"
                                        Tag="90" />
                                    <Button
                                        Padding="8,4"
                                        Click="PresetDays_Click"
                                        Content="+1 год"
                                        Tag="365" />
                                    <Button
                                        Padding="8,4"
                                        Click="PresetDays_Click"
                                        Content="+3 года"
                                        Tag="1095" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Заметки -->
                        <TextBox
                            AcceptsReturn="True"
                            Header="Заметки"
                            PlaceholderText="Дополнительные примечания, пин-коды или резервные коды..."
                            Text="{x:Bind ViewModel.EditNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <!-- Кнопки сохранения/отмены -->
                        <Grid Margin="0,12,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Command="{x:Bind ViewModel.SaveEntryCommand}"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                                <TextBlock FontWeight="SemiBold" Text="Сохранить" />
                            </Button>

                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Click="CloseEditDialog_Click"
                                Content="Отмена" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ДИАЛОГ НАСТРОЕК ХРАНИЛИЩА И ОБЛАКА (МОДАЛЬНЫЙ ОВЕРЛЕЙ) -->
        <Grid Background="#7F000000" Visibility="{x:Bind BoolToVis(ViewModel.IsSettingsDialogVisible), Mode=OneWay}">
            <Border
                Width="520"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Padding="28" Spacing="16">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Text="Настройки STORM KEYS" />

                    <!-- Локальный путь -->
                    <TextBox
                        Header="Локальное зашифрованное хранилище"
                        IsReadOnly="True"
                        Text="{x:Bind ViewModel.SettingsLocalPath, Mode=OneWay}" />

                    <!-- Облачная синхронизация -->
                    <StackPanel Spacing="8">
                        <ToggleSwitch Header="Синхронизация с облачным диском (OneDrive, Google Drive, WebDAV)" IsOn="{x:Bind ViewModel.SettingsCloudEnabled, Mode=TwoWay}" />

                        <Grid ColumnSpacing="8" Visibility="{x:Bind BoolToVis(ViewModel.SettingsCloudEnabled), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                PlaceholderText="Путь к облачной папке..."
                                Text="{x:Bind ViewModel.SettingsCloudFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                Grid.Column="1"
                                Click="PickCloudFolder_Click"
                                Content="Обзор..." />
                        </Grid>
                    </StackPanel>

                    <!-- Оформление STORM AURORA FLUID -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 9 Динамических тем -->
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Тема оформления (9 тем)" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.AvailableThemes}"
                                SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- 13 Цветов акцентов -->
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Цвет акцента (13 акцентов)" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.AvailableAccents}"
                                SelectedItem="{x:Bind ViewModel.SelectedAccent, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 11 Языков интерфейса -->
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Язык интерфейса (11 языков)" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.AvailableLanguages}"
                                SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- 10 Динамических шрифтов -->
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Шрифт (10 шрифтов)" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.AvailableFonts}"
                                SelectedItem="{x:Bind ViewModel.SelectedFont, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <!-- Автоблокировка -->
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="Автоблокировка при бездействии" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind AutoLockOptions}"
                            SelectedIndex="{x:Bind AutoLockIndex, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Статус сертификата STORM -->
                    <Border
                        Padding="12"
                        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Foreground="#107C41"
                                Glyph="&#xE73E;" />
                            <StackPanel>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="#107C41"
                                    Text="{x:Bind ViewModel.CertificateStatus, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Шифрование AES-256-GCM • Хеширование Argon2id • Экосистема STORM" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Автоматическое обновление (Auto-Update System) -->
                    <Border
                        Padding="12"
                        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="Обновления STORM KEYS" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                    IsEnabled="{x:Bind Not(ViewModel.IsCheckingUpdate), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE895;" />
                                        <TextBlock Text="Проверить" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Кнопка установить при доступном обновлении -->
                            <StackPanel Spacing="6" Visibility="{x:Bind BoolToVis(ViewModel.IsUpdateAvailable), Mode=OneWay}">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Command="{x:Bind ViewModel.InstallUpdateCommand}"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" />
                                        <TextBlock Text="Установить обновление" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Кнопки диалога -->
                    <Grid Margin="0,12,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Command="{x:Bind ViewModel.SaveSettingsCommand}"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Content="Сохранить" />

                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Click="CloseSettingsDialog_Click"
                            Content="Закрыть" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ЭКРАН БЛОКИРОВКИ / АВТОРИЗАЦИИ (ОВЕРЛЕЙ) -->
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="{x:Bind BoolToVis(ViewModel.IsVaultLocked), Mode=OneWay}">
            <Border
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Padding="36" Spacing="20">
                    <!-- Логотип STORM KEYS -->
                    <Border
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Background="#0078D4"
                        CornerRadius="16">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="32"
                            Foreground="White"
                            Glyph="&#xE8D7;" />
                    </Border>

                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="24"
                            FontWeight="Bold"
                            Text="STORM KEYS" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Защищенное хранилище ключей и паролей" />
                    </StackPanel>

                    <!-- Состояние: Первичная настройка (Задать пароль) -->
                    <StackPanel Spacing="12" Visibility="{x:Bind BoolToVis(ViewModel.IsVaultUninitialized), Mode=OneWay}">
                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="Задайте мастер-пароль для инициализации зашифрованного хранилища."
                            Severity="Informational" />

                        <PasswordBox
                            x:Name="NewMasterPasswordBox"
                            Header="Мастер-пароль (минимум 6 символов)"
                            Password="{x:Bind ViewModel.MasterPasswordInput, Mode=TwoWay}"
                            PlaceholderText="Придумайте надежный мастер-пароль" />

                        <PasswordBox
                            x:Name="ConfirmMasterPasswordBox"
                            Header="Подтвердите мастер-пароль"
                            Password="{x:Bind ViewModel.ConfirmPasswordInput, Mode=TwoWay}"
                            PlaceholderText="Повторите ввод мастер-пароля" />

                        <Button
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Command="{x:Bind ViewModel.UnlockOrCreateVaultCommand}"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                            <TextBlock FontWeight="SemiBold" Text="Создать хранилище" />
                        </Button>
                    </StackPanel>

                    <!-- Состояние: Разблокировка существующего хранилища -->
                    <StackPanel Spacing="14" Visibility="{x:Bind InvBoolToVis(ViewModel.IsVaultUninitialized), Mode=OneWay}">
                        <PasswordBox
                            x:Name="UnlockPasswordBox"
                            Header="Мастер-пароль"
                            KeyDown="UnlockPasswordBox_KeyDown"
                            Password="{x:Bind ViewModel.MasterPasswordInput, Mode=TwoWay}"
                            PlaceholderText="Введите мастер-пароль для доступа..." />

                        <Button
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Command="{x:Bind ViewModel.UnlockOrCreateVaultCommand}"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                            <TextBlock FontWeight="SemiBold" Text="Разблокировать хранилище" />
                        </Button>
                    </StackPanel>

                    <!-- Ошибка мастер-пароля -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#D13438"
                        Text="{x:Bind ViewModel.MasterPasswordErrorMessage, Mode=OneWay}"
                        Visibility="{x:Bind StringToVis(ViewModel.MasterPasswordErrorMessage), Mode=OneWay}" />

                    <!-- Индикатор загрузки -->
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind BoolToVis(ViewModel.IsLoading), Mode=OneWay}" />

                    <!-- Защитный бейдж -->
                    <Border
                        Padding="8,4"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="AES-256-GCM • Argon2id KDF • STORM ECOSYSTEM" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
