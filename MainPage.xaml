<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StormKeys.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:StormKeys"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{x:Bind ViewModel.CurrentBackgroundBrush, Mode=OneWay}">
        <!-- ОСНОВНАЯ ОБЛАСТЬ ПРИЛОЖЕНИЯ (КОГДА РАЗБЛОКИРОВАНО) -->
        <Grid Visibility="{x:Bind InvBoolToVis(ViewModel.IsVaultLocked), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Верхняя панель команд и навигации -->
            <Border
                Grid.Row="0"
                Padding="24,12,24,12"
                Background="{x:Bind ViewModel.CurrentHeaderBrush, Mode=OneWay}"
                BorderBrush="{x:Bind ViewModel.CurrentCardStrokeBrush, Mode=OneWay}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Логотип и Бренд -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Grid Width="38" Height="38">
                            <Border
                                Width="38"
                                Height="38"
                                CornerRadius="10"
                                Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                Opacity="0.22" />
                            <Image
                                Width="34"
                                Height="34"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="ms-appx:///Assets/Square44x44Logo.scale-200.png"
                                Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="{x:Bind ViewModel.UiTitle, Mode=OneWay}"
                                    Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                                <Border
                                    Padding="6,1,6,1"
                                    Background="#26107C41"
                                    BorderBrush="#107C41"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="#107C41"
                                        Text="CERTIFIED" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{x:Bind ViewModel.CurrentTextSecondaryBrush, Mode=OneWay}"
                                Text="{x:Bind ViewModel.UiSubtitle, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Строка поиска -->
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        MaxWidth="460"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        PlaceholderText="{x:Bind ViewModel.UiSearchPlaceholder, Mode=OneWay}"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Кнопки быстрых действий -->
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                            Click="AddEntry_Click"
                            Foreground="#FFFFFF"
                            ToolTipService.ToolTip="Добавить новую запись вручную (Ctrl+N)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.UiAdd, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <Button
                            Click="ImportClipboard_Click"
                            ToolTipService.ToolTip="Быстрая вставка данных из буфера обмена: логин:пароль, ключ, .env, otpauth:// (Ctrl+V)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE77F;" />
                                <TextBlock FontWeight="SemiBold" Text="Вставить" />
                            </StackPanel>
                        </Button>

                        <Button Click="ImportMenu_Click" ToolTipService.ToolTip="{x:Bind ViewModel.UiTooltipImport, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B5;" />
                                <TextBlock Text="{x:Bind ViewModel.UiImport, Mode=OneWay}" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="ImportFile_Click" Text="Импорт из файла (CSV / JSON / .env / .txt)">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8E5;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="ImportClipboard_Click" Text="Быстрая вставка из буфера (Ctrl+V)">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE77F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button Click="ExportMenu_Click" ToolTipService.ToolTip="{x:Bind ViewModel.UiTooltipExport, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEDE1;" />
                                <TextBlock Text="{x:Bind ViewModel.UiExport, Mode=OneWay}" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="ExportCsv_Click" Text="Экспорт в CSV" />
                                    <MenuFlyoutItem Click="ExportJson_Click" Text="Экспорт в JSON" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="ExportRecoveryKit_Click" Text="Аварийный лист восстановления (.txt)" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button Click="ToggleDensity_Click" ToolTipService.ToolTip="Переключить компактный / комфортный вид карточек">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A9;" />
                        </Button>

                        <Button Command="{x:Bind ViewModel.SyncCloudCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.CloudSyncStatusText, Mode=OneWay}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE753;" />
                        </Button>

                        <Button Click="OpenSettings_Click" ToolTipService.ToolTip="{x:Bind ViewModel.UiTooltipSettings, Mode=OneWay}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                        </Button>

                        <Button Command="{x:Bind ViewModel.LockVaultCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.UiTooltipLock, Mode=OneWay}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72E;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Сводные метрические карточки и индекс безопасности -->
            <StackPanel Grid.Row="1" Margin="24,12,24,4" Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Всего записей -->
                    <Border
                        Grid.Column="0"
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.UiTotalKeys, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Text="{x:Bind ViewModel.TotalEntriesCount, Mode=OneWay}" />
                            </StackPanel>
                            <FontIcon
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="24"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE8D7;"
                                Opacity="0.7" />
                        </Grid>
                    </Border>

                    <!-- Истекающие скоро (<= 30 дней) -->
                    <Border
                        Grid.Column="1"
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.UiExpiringSoon, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="#FF8C00"
                                    Text="{x:Bind ViewModel.ExpiringSoonCount, Mode=OneWay}" />
                            </StackPanel>
                            <FontIcon
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="24"
                                Foreground="#FF8C00"
                                Glyph="&#xE7BA;"
                                Opacity="0.8" />
                        </Grid>
                    </Border>

                    <!-- Истёкшие -->
                    <Border
                        Grid.Column="2"
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.UiExpiredLicenses, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="#D13438"
                                    Text="{x:Bind ViewModel.ExpiredCount, Mode=OneWay}" />
                            </StackPanel>
                            <FontIcon
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="24"
                                Foreground="#D13438"
                                Glyph="&#xEA39;"
                                Opacity="0.8" />
                        </Grid>
                    </Border>

                    <!-- Облако / Хранилище -->
                    <Border
                        Grid.Column="3"
                        Padding="16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.UiSyncStatus, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.CloudSyncStatusText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="24"
                                Foreground="#0078D4"
                                Glyph="&#xE753;"
                                Opacity="0.8" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ДИНАМИЧЕСКИЙ ГРАФИК ЗДОРОВЬЯ ХРАНИЛИЩА (LIVE DYNAMIC HEALTH GAUGE) -->
                <Border
                    Padding="16,8"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9D9;" FontSize="14" Foreground="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Индекс безопасности:" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                            <TextBlock FontSize="12" FontWeight="Bold" Text="{x:Bind ViewModel.HealthScoreText, Mode=OneWay}" Foreground="#107C41" />
                        </StackPanel>

                        <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                            <ProgressBar
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Maximum="1.0"
                                Value="{x:Bind ViewModel.ActiveRatio, Mode=OneWay}"
                                Foreground="#107C41" />
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="8" Height="8" Fill="#107C41" />
                                <TextBlock FontSize="11" Text="Активные" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="8" Height="8" Fill="#FF8C00" />
                                <TextBlock FontSize="11" Text="Истекающие" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="8" Height="8" Fill="#D13438" />
                                <TextBlock FontSize="11" Text="Истёкшие" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 3. Фильтры категорий, сроков, сортировки и быстрые чипы -->
            <StackPanel Grid.Row="2" Margin="24,4,24,8" Spacing="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Grid.Column="0"
                        ItemsSource="{x:Bind CategoryFilterOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedCategoryFilter, Mode=TwoWay}" />

                    <ComboBox
                        Grid.Column="1"
                        ItemsSource="{x:Bind ExpirationFilterOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedExpirationFilter, Mode=TwoWay}" />

                    <ComboBox
                        Grid.Column="2"
                        ItemsSource="{x:Bind SortOrderOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedSortOrder, Mode=TwoWay}"
                        ToolTipService.ToolTip="Режим сортировки записей" />

                    <Button
                        Grid.Column="3"
                        Command="{x:Bind ViewModel.UndoDeleteCommand}"
                        Visibility="{x:Bind BoolToVis(ViewModel.CanUndoDelete), Mode=OneWay}"
                        ToolTipService.ToolTip="Восстановить последнюю удалённую запись (Ctrl+Z)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" FontSize="12" />
                            <TextBlock Text="Вернуть удалённую" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Информационное сообщение -->
                    <InfoBar
                        Grid.Column="4"
                        IsClosable="True"
                        IsOpen="{x:Bind HasText(ViewModel.StatusMessage), Mode=OneWay}"
                        Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Severity="Informational" />
                </Grid>

                <!-- Быстрые чипы категорий и статусов -->
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Padding="12,6" Click="FilterChip_Click" Tag="All" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Все" FontWeight="SemiBold" FontSize="12" />
                                <Border Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" CornerRadius="10" Padding="6,1">
                                    <TextBlock Text="{x:Bind ViewModel.TotalEntriesCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6" Click="FilterChip_Click" Tag="Favorites" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE735;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FFB900" />
                                <TextBlock Text="Избранное" FontWeight="SemiBold" FontSize="12" />
                                <Border Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" CornerRadius="10" Padding="6,1">
                                    <TextBlock Text="{x:Bind ViewModel.FavoritesCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6" Click="FilterChip_Click" Tag="Account" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                <TextBlock Text="Аккаунты" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6" Click="FilterChip_Click" Tag="License" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                <TextBlock Text="Лицензии" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6" Click="FilterChip_Click" Tag="ApiKey" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE943;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                <TextBlock Text="API / Токены" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6" Click="FilterChip_Click" Tag="Server" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                <TextBlock Text="Серверы / RDP" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6" Click="FilterChip_Click" Tag="BankCard" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C7;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                <TextBlock Text="Карты" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6" Click="FilterChip_Click" Tag="Wifi" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE701;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                <TextBlock Text="Wi-Fi" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6" Click="FilterChip_Click" Tag="Crypto" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8AC;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                <TextBlock Text="Крипто" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6" Click="FilterChip_Click" Tag="Breached" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#D13438" />
                                <TextBlock Text="В утечках" FontWeight="SemiBold" FontSize="12" Foreground="#D13438" />
                                <Border Background="#25D13438" CornerRadius="10" Padding="6,1">
                                    <TextBlock Text="{x:Bind ViewModel.BreachedCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#D13438" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6" Click="FilterChip_Click" Tag="Weak" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FF8C00" />
                                <TextBlock Text="Слабые" FontWeight="SemiBold" FontSize="12" />
                                <Border Background="#25FF8C00" CornerRadius="10" Padding="6,1">
                                    <TextBlock Text="{x:Bind ViewModel.WeakPasswordsCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#FF8C00" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6" Click="FilterChip_Click" Tag="Duplicates" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FF8C00" />
                                <TextBlock Text="Дубликаты" FontWeight="SemiBold" FontSize="12" />
                                <Border Background="#25FF8C00" CornerRadius="10" Padding="6,1">
                                    <TextBlock Text="{x:Bind ViewModel.DuplicatePasswordsCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#FF8C00" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6" Click="FilterChip_Click" Tag="Expiring" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FF8C00" />
                                <TextBlock Text="Истекающие" FontWeight="SemiBold" FontSize="12" />
                                <Border Background="#25FF8C00" CornerRadius="10" Padding="6,1">
                                    <TextBlock Text="{x:Bind ViewModel.ExpiringSoonCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#FF8C00" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <!-- 4А. ИНТЕРАКТИВНАЯ ПАНЕЛЬ БЫСТРОГО СТАРТА (КОГДА ХРАНИЛИЩЕ ПУСТОЕ) -->
            <Border
                Grid.Row="3"
                Margin="24,8,24,24"
                Padding="32"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{x:Bind BoolToVis(ViewModel.IsVaultEmpty), Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="760" Spacing="18">
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="36"
                            Foreground="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                            Glyph="&#xE8D7;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="Как добавить ключи, пароли и 2FA в хранилище" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Выберите любой удобный способ: ручное создание по шаблону (Ctrl+N), умная вставка из буфера (Ctrl+V) или импорт файла."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Главные кнопки создания и вставки -->
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12">
                        <Button
                            Padding="18,10"
                            Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                            Click="AddEntry_Click"
                            Foreground="#FFFFFF">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" />
                                <TextBlock FontWeight="Bold" Text="Добавить запись вручную (Ctrl+N)" />
                            </StackPanel>
                        </Button>

                        <Button
                            Padding="16,10"
                            Click="ImportClipboard_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE77F;" />
                                <TextBlock FontWeight="SemiBold" Text="Быстрая вставка из буфера (Ctrl+V)" />
                            </StackPanel>
                        </Button>

                        <Button
                            Padding="16,10"
                            Click="ImportFile_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E5;" />
                                <TextBlock FontWeight="SemiBold" Text="Импорт из файла (CSV / JSON / .env)" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Быстрые шаблоны форматов в 1 клик -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Или создайте запись сразу по готовому шаблону формата:" />
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <Button Click="QuickAddTemplate_Click" Tag="Account">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE77B;" />
                                    <TextBlock Text="Сайт / Аккаунт + 2FA" />
                                </StackPanel>
                            </Button>
                            <Button Click="QuickAddTemplate_Click" Tag="License">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8A7;" />
                                    <TextBlock Text="Лицензия ПО / Игры" />
                                </StackPanel>
                            </Button>
                            <Button Click="QuickAddTemplate_Click" Tag="ApiKey">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE943;" />
                                    <TextBlock Text="API Ключ / Токен" />
                                </StackPanel>
                            </Button>
                            <Button Click="QuickAddTemplate_Click" Tag="Server">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xEDA2;" />
                                    <TextBlock Text="Сервер / SSH / RDP" />
                                </StackPanel>
                            </Button>
                            <Button Click="QuickAddTemplate_Click" Tag="BankCard">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8C7;" />
                                    <TextBlock Text="Банковская карта" />
                                </StackPanel>
                            </Button>
                            <Button Click="QuickAddTemplate_Click" Tag="Wifi">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE701;" />
                                    <TextBlock Text="Wi-Fi" />
                                </StackPanel>
                            </Button>
                            <Button Click="QuickAddTemplate_Click" Tag="Crypto">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8AC;" />
                                    <TextBlock Text="Крипто / Seed" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4Б. Список карточек ключей и паролей -->
            <ListView
                Grid.Row="3"
                Padding="24,0,24,24"
                ItemsSource="{x:Bind ViewModel.FilteredEntries, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind InvBoolToVis(ViewModel.IsVaultEmpty), Mode=OneWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Кастомная или категориальная иконка -->
                                <Border
                                    Grid.Column="0"
                                    Width="42"
                                    Height="42"
                                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                    CornerRadius="8">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="19"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                        Glyph="{Binding EffectiveGlyph}" />
                                </Border>

                                <!-- Название и целевой сервис/приложение -->
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding TargetAppOrUrl}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                        Text="{Binding TagsDisplayText}"
                                        Visibility="{Binding TagsVisibility}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Логин / Email с кнопкой быстрого копирования -->
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        MaxWidth="160"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{Binding UsernameOrEmail}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Padding="6,4"
                                        Click="CopyUsername_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="{Binding ElementName=RootPage, Path=ViewModel.UiTooltipCopyUsername}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="12"
                                            Glyph="&#xE8C8;" />
                                    </Button>
                                </StackPanel>

                                <!-- Секрет (Пароль/Ключ), 2FA TOTP и Срок действия -->
                                <StackPanel
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            MaxWidth="180"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Text="{Binding DisplayedSecret}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Padding="6,4"
                                            Click="PeekSecret_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Показать / скрыть секрет на 5 сек.">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="12"
                                                Glyph="{Binding PeekGlyph}" />
                                        </Button>
                                        <Button
                                            Padding="6,4"
                                            Click="CopySecret_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="{Binding ElementName=RootPage, Path=ViewModel.UiTooltipCopyPassword}">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="12"
                                                Glyph="&#xE8C8;" />
                                        </Button>
                                    </StackPanel>

                                    <!-- 2FA / TOTP Код с живым 30-секундным таймером и кнопкой авто-ввода 2FA -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding TotpVisibility}">
                                        <Border
                                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon
                                                    Glyph="&#xE8D7;"
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock
                                                    Text="{Binding FormattedTotpCode}"
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock
                                                    Text="{Binding TotpCountdownText}"
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Button
                                            Padding="5,3"
                                            Click="CopyTotp_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="{Binding ElementName=RootPage, Path=ViewModel.UiTotpCopyTooltip}">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="11"
                                                Glyph="&#xE8C8;" />
                                        </Button>
                                        <Button
                                            Padding="5,3"
                                            Click="AutoTypeTotp_Click"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Быстро ввести код 2FA в активное окно браузера/программы">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="11"
                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                Glyph="&#xE945;" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Бейджи статуса срока и аудита утечек -->
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border
                                            Padding="6,2"
                                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="{Binding ExpirationStatusText}" />
                                        </Border>

                                        <Border
                                            Padding="6,2"
                                            Background="#25D13438"
                                            BorderBrush="#D13438"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{Binding PwnedBreachedVisibility}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#D13438" />
                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#D13438" Text="{Binding PwnedStatusText}" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Padding="6,2"
                                            Background="#25107C41"
                                            BorderBrush="#107C41"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{Binding PwnedSafeVisibility}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#107C41" />
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#107C41" Text="Безопасен" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Действия: Авто-вставка, Запуск программы/сайта, Избранное, Дубликат, Сводка, HIBP, Детали, Редактировать, Удалить -->
                                <StackPanel
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <!-- Быстрая вставка / Авто-ввод (Логин + Tab + Пароль + 2FA в буфер) -->
                                    <Button
                                        Padding="8,6"
                                        Click="QuickAutoType_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Быстрая вставка (Авто-ввод): ввести Логин + Tab + Пароль в предыдущее окно (и скопировать код 2FA)">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                            Glyph="&#xE945;" />
                                    </Button>

                                    <!-- Запуск привязанной программы (.exe) или переход на сайт (URL) -->
                                    <Button
                                        Padding="8,6"
                                        Click="LaunchWebsite_Click"
                                        Tag="{Binding}"
                                        Visibility="{Binding HasLaunchTargetVisibility}"
                                        ToolTipService.ToolTip="{Binding LaunchTargetTooltip}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="#10B981"
                                            Glyph="{Binding LaunchTargetGlyph}" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="ToggleFavorite_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="В избранное / Закрепить">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="#FFB900"
                                            Glyph="{Binding FavoriteGlyph}" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="DuplicateEntry_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Дублировать запись (Ctrl+D)">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Glyph="&#xF413;" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="CopySummary_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Скопировать полную сводку карточки">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Glyph="&#xE77F;" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="CheckPwned_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Проверить в базе утечек Have I Been Pwned">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                            Glyph="&#xE72C;" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="ShowCardDetails_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="{Binding ElementName=RootPage, Path=ViewModel.UiTooltipCardDetails}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="#0078D4"
                                            Glyph="&#xE946;" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="EditEntry_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="{Binding ElementName=RootPage, Path=ViewModel.UiTooltipEdit}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Glyph="&#xE70F;" />
                                    </Button>

                                    <Button
                                        Padding="8,6"
                                        Click="DeleteEntry_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="{Binding ElementName=RootPage, Path=ViewModel.UiTooltipDelete}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="#D13438"
                                            Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- СТИЛИЗОВАННАЯ ПОДСКАЗКА (TEACHING TIP) -->
        <TeachingTip
            x:Name="CardTeachingTip"
            Title="{x:Bind ViewModel.TeachingTipTitle, Mode=OneWay}"
            IsLightDismissEnabled="True"
            IsOpen="{x:Bind ViewModel.IsTeachingTipOpen, Mode=TwoWay}"
            Subtitle="{x:Bind ViewModel.TeachingTipSubtitle, Mode=OneWay}">
            <TeachingTip.Content>
                <StackPanel Margin="0,8,0,0" Spacing="10">
                    <Border
                        Padding="8,4"
                        BorderBrush="{x:Bind HexToBrush(ViewModel.TeachingTipBadgeColor), Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{x:Bind HexToBrush(ViewModel.TeachingTipBadgeColor), Mode=OneWay}"
                            Text="{x:Bind ViewModel.TeachingTipStatus, Mode=OneWay}" />
                    </Border>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Ключ/Пароль надежно сохранен в зашифрованном контейнере." />
                </StackPanel>
            </TeachingTip.Content>
        </TeachingTip>

        <!-- ДИАЛОГ ДОБАВЛЕНИЯ / РЕДАКТИРОВАНИЯ (МАКСИМАЛЬНО ПРОКАЧАННЫЙ В 1.0.4) -->
        <Grid Background="#7F000000" Visibility="{x:Bind BoolToVis(ViewModel.IsEditDialogVisible), Mode=OneWay}">
            <Border
                Width="680"
                MaxHeight="740"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{x:Bind ViewModel.CurrentHeaderBrush, Mode=OneWay}"
                BorderBrush="{x:Bind ViewModel.CurrentCardStrokeBrush, Mode=OneWay}"
                BorderThickness="1"
                CornerRadius="14">
                <ScrollViewer Padding="26,22,26,22">
                    <StackPanel Spacing="14">
                        <!-- Шапка диалога с превью выбранной иконки и кнопкой умного заполнения из буфера -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="42"
                                Height="42"
                                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                BorderBrush="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="20"
                                    Foreground="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                    Glyph="{x:Bind ViewModel.EditPreviewGlyph, Mode=OneWay}" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.EditDialogHeader, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{x:Bind ViewModel.CurrentTextSecondaryBrush, Mode=OneWay}"
                                    Text="Все форматы данных • Выбор иконки • Генератор с параметрами • Живой 2FA • Привязка .exe и URL" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.FillDialogFromClipboardCommand}"
                                ToolTipService.ToolTip="Распознать и заполнить поля из буфера обмена (логин:пароль, otpauth://, .env, ключ ПО, URL)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE77F;" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Из буфера" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 1. Шаблоны всех форматов данных в 1 клик -->
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind ViewModel.CurrentTextSecondaryBrush, Mode=OneWay}"
                                Text="Быстрый шаблон формата записи:" />
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Padding="10,5" Click="ApplyTemplateInDialog_Click" Tag="Account" Content="Сайт / Аккаунт" FontSize="11" />
                                    <Button Padding="10,5" Click="ApplyTemplateInDialog_Click" Tag="License" Content="Лицензия ПО / Игры" FontSize="11" />
                                    <Button Padding="10,5" Click="ApplyTemplateInDialog_Click" Tag="ApiKey" Content="API Ключ / Токен" FontSize="11" />
                                    <Button Padding="10,5" Click="ApplyTemplateInDialog_Click" Tag="Certificate" Content="SSH / Сертификат" FontSize="11" />
                                    <Button Padding="10,5" Click="ApplyTemplateInDialog_Click" Tag="Server" Content="Сервер / БД / RDP" FontSize="11" />
                                    <Button Padding="10,5" Click="ApplyTemplateInDialog_Click" Tag="BankCard" Content="Банковская карта" FontSize="11" />
                                    <Button Padding="10,5" Click="ApplyTemplateInDialog_Click" Tag="Wifi" Content="Сеть Wi-Fi" FontSize="11" />
                                    <Button Padding="10,5" Click="ApplyTemplateInDialog_Click" Tag="Crypto" Content="Крипто / Seed" FontSize="11" />
                                    <Button Padding="10,5" Click="ApplyTemplateInDialog_Click" Tag="Other" Content="Заметка / PIN" FontSize="11" />
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- 2. Выбор иконки записи (20 семантических значков) -->
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind ViewModel.CurrentTextSecondaryBrush, Mode=OneWay}"
                                Text="Выбор иконки карточки (20 значков):" />
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableIcons}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Width="34"
                                                Height="34"
                                                Padding="0"
                                                Click="SelectIcon_Click"
                                                Tag="{Binding Glyph}"
                                                ToolTipService.ToolTip="{Binding Name}">
                                                <FontIcon
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="15"
                                                    Glyph="{Binding Glyph}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- 3. Название и Категория (в 2 колонки) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                Header="Название сервиса, сайта или программы *"
                                PlaceholderText="GitHub, Steam, Windows 11 Pro, Сервер..."
                                Text="{x:Bind ViewModel.EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Header="Категория / Формат"
                                ItemsSource="{x:Bind CategoryEditOptions}"
                                SelectedIndex="{x:Bind EditCategoryIndex, Mode=TwoWay}" />
                        </Grid>

                        <!-- 4. Логин / Email и Привязка к программе (.exe) или сайту (URL) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                Header="Логин, Email, ID или Номер карты"
                                PlaceholderText="user@example.com / admin / root"
                                Text="{x:Bind ViewModel.EditUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox
                                Grid.Column="1"
                                Header="Привязка к сайту (URL) или программе (.exe)"
                                PlaceholderText="https://... или C:\...\app.exe"
                                Text="{x:Bind ViewModel.EditTargetApp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Click="PickTargetApp_Click"
                                ToolTipService.ToolTip="Выбрать локальную программу (.exe, .lnk, .rdp, .bat) для быстрого запуска с карточки">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8E5;" />
                                    <TextBlock FontSize="12" Text="Выбрать .exe" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 5. Пароль / Секретный ключ + Настраиваемый генератор паролей с указанием параметров -->
                        <Border
                            Padding="14,12"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        Grid.Column="0"
                                        Header="Пароль, Токен, Seed-фраза или Лицензионный ключ *"
                                        PlaceholderText="Введите вручную или сгенерируйте по параметрам ниже"
                                        Text="{x:Bind ViewModel.EditSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.GeneratePasswordCommand}"
                                        Foreground="#FFFFFF"
                                        ToolTipService.ToolTip="Сгенерировать пароль по указанным ниже параметрам длины и символов">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8D7;" />
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Пароль" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.GeneratePassphraseCommand}"
                                        ToolTipService.ToolTip="Сгенерировать мнемоническую парольную фразу из 4 слов (Diceware)">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Фраза" />
                                    </Button>

                                    <Button
                                        Grid.Column="3"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.GenerateLicenseKeyCommand}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.UiTooltipGenSoftwareKey, Mode=OneWay}">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Ключ ПО" />
                                    </Button>

                                    <Button
                                        Grid.Column="4"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.GeneratePinCodeCommand}"
                                        ToolTipService.ToolTip="Сгенерировать цифровой PIN-код">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="PIN" />
                                    </Button>
                                </Grid>

                                <!-- Настройки параметров генератора паролей: Длина (ползунок + пресеты) и Наборы символов -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="Длина пароля:" />

                                    <Slider
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Minimum="6"
                                        Maximum="64"
                                        StepFrequency="1"
                                        Value="{x:Bind IntToDouble(ViewModel.GenPasswordLength), Mode=OneWay}"
                                        ValueChanged="GenSlider_ValueChanged" />

                                    <Border
                                        Grid.Column="2"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Text="{x:Bind FormatGenLen(ViewModel.GenPasswordLength), Mode=OneWay}" />
                                    </Border>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Padding="6,2" Click="GenLenPreset_Click" Tag="12" Content="12" FontSize="11" />
                                        <Button Padding="6,2" Click="GenLenPreset_Click" Tag="16" Content="16" FontSize="11" />
                                        <Button Padding="6,2" Click="GenLenPreset_Click" Tag="24" Content="24" FontSize="11" />
                                        <Button Padding="6,2" Click="GenLenPreset_Click" Tag="32" Content="32" FontSize="11" />
                                        <Button Padding="6,2" Click="GenLenPreset_Click" Tag="48" Content="48" FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <!-- Чекбоксы классов символов генератора -->
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <CheckBox MinWidth="0" Content="A–Z (Заглавные)" FontSize="12" IsChecked="{x:Bind ViewModel.GenUseUpper, Mode=TwoWay}" />
                                    <CheckBox MinWidth="0" Content="a–z (Строчные)" FontSize="12" IsChecked="{x:Bind ViewModel.GenUseLower, Mode=TwoWay}" />
                                    <CheckBox MinWidth="0" Content="0–9 (Цифры)" FontSize="12" IsChecked="{x:Bind ViewModel.GenUseDigits, Mode=TwoWay}" />
                                    <CheckBox MinWidth="0" Content="!@#$%^&amp;* (Спец.)" FontSize="12" IsChecked="{x:Bind ViewModel.GenUseSpecial, Mode=TwoWay}" />
                                    <CheckBox MinWidth="0" Content="Без похожих (0/O, 1/l)" FontSize="12" IsChecked="{x:Bind ViewModel.GenExcludeAmbiguous, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- Индикатор надежности, битовой энтропии и времени взлома -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Надёжность:" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{x:Bind HexToBrush(ViewModel.SecretStrengthColor), Mode=OneWay}"
                                        Text="{x:Bind ViewModel.SecretStrengthLabel, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="• Энтропия:" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.SecretEntropyText, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="• Оценка взлома:" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                        Text="{x:Bind ViewModel.SecretCrackTimeText, Mode=OneWay}" />
                                </StackPanel>

                                <!-- История паролей записи -->
                                <Grid ColumnSpacing="8" Visibility="{x:Bind BoolToVis(ViewModel.HasPasswordHistory), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.EditPasswordHistoryText, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Padding="8,4"
                                        Command="{x:Bind ViewModel.RestorePreviousPasswordCommand}"
                                        Content="Восстановить пред. пароль"
                                        FontSize="11" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 6. Двухфакторная аутентификация (2FA / TOTP) + Живая проверка прохождения 2FA -->
                        <Border
                            Padding="14,12"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        Grid.Column="0"
                                        Header="Двухфакторная аутентификация 2FA (Base32 ключ или ссылка otpauth://totp/...)"
                                        PlaceholderText="Вставьте секретный ключ с сайта (JBSWY3DPEHPK3PXP) или URI otpauth://..."
                                        Text="{x:Bind ViewModel.EditTotpSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.GenerateTotpSecretCommand}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.UiTotpGenerate, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE72C;" />
                                            <TextBlock FontSize="12" Text="Создать ключ 2FA" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Живое табло прохождения 2FA прямо внутри диалога -->
                                <Border
                                    Padding="12,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="{x:Bind BoolToVis(ViewModel.HasValidEditTotp), Mode=OneWay}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#10B981" Glyph="&#xE73E;" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Foreground="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                                Text="{x:Bind ViewModel.EditTotpLiveCode, Mode=OneWay}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.EditTotpCountdownText, Mode=OneWay}" />
                                            <ProgressBar
                                                Maximum="1.0"
                                                Value="{x:Bind ViewModel.EditTotpProgressRatio, Mode=OneWay}"
                                                Foreground="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}" />
                                        </StackPanel>

                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Command="{x:Bind ViewModel.CopyEditTotpCodeCommand}"
                                            ToolTipService.ToolTip="Скопировать текущий 6-значный код для подтверждения привязки 2FA на сайте">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE8C8;" />
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Копировать код 2FA" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 7. Теги и Пользовательские атрибуты (CVV, PIN, Порт, IP, Seed) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                Header="Теги (через запятую)"
                                PlaceholderText="работа, облако, банк, steam..."
                                Text="{x:Bind ViewModel.EditTagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox
                                Grid.Column="1"
                                AcceptsReturn="True"
                                Header="Доп. поля (Ключ: Значение, по 1 на строку)"
                                PlaceholderText="PIN: 1234&#x0a;Порт: 22&#x0a;CVV: 999"
                                Text="{x:Bind ViewModel.EditCustomFieldsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <!-- 8. Срок действия (ExpirationDate) и Заметки -->
                        <StackPanel Spacing="8">
                            <CheckBox Content="Указать конечную дату действия (уведомления за 30, 7, 1 день)" IsChecked="{x:Bind ViewModel.EditHasExpiration, Mode=TwoWay}" />

                            <StackPanel Spacing="8" Visibility="{x:Bind BoolToVis(ViewModel.EditHasExpiration), Mode=OneWay}">
                                <DatePicker HorizontalAlignment="Stretch" Date="{x:Bind EditDatePickerDate, Mode=TwoWay}" />

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Padding="8,4" Click="PresetDays_Click" Content="+30 дней" Tag="30" />
                                    <Button Padding="8,4" Click="PresetDays_Click" Content="+90 дней" Tag="90" />
                                    <Button Padding="8,4" Click="PresetDays_Click" Content="+1 год" Tag="365" />
                                    <Button Padding="8,4" Click="PresetDays_Click" Content="+3 года" Tag="1095" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <TextBox
                            AcceptsReturn="True"
                            Header="Заметки и резервные коды восстановления"
                            PlaceholderText="Дополнительные примечания, резервные коды 2FA или инструкции..."
                            Text="{x:Bind ViewModel.EditNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <!-- Кнопки сохранения/отмены -->
                        <Grid Margin="0,8,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                Command="{x:Bind ViewModel.SaveEntryCommand}"
                                Foreground="#FFFFFF">
                                <TextBlock FontWeight="SemiBold" Text="Сохранить запись" />
                            </Button>

                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Click="CloseEditDialog_Click"
                                Content="Отмена (Esc)" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ДИАЛОГ НАСТРОЕК ХРАНИЛИЩА И ОБЛАКА (МОДАЛЬНЫЙ ОВЕРЛЕЙ) -->
        <Grid Background="#7F000000" Visibility="{x:Bind BoolToVis(ViewModel.IsSettingsDialogVisible), Mode=OneWay}">
            <Border
                Width="540"
                MaxHeight="700"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{x:Bind ViewModel.CurrentHeaderBrush, Mode=OneWay}"
                BorderBrush="{x:Bind ViewModel.CurrentCardStrokeBrush, Mode=OneWay}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer Padding="28">
                    <StackPanel Spacing="14">
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Text="{x:Bind ViewModel.UiSettingsTitle, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />

                        <!-- Локальный путь -->
                        <TextBox
                            Header="{x:Bind ViewModel.UiSettingsLocalVault, Mode=OneWay}"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.SettingsLocalPath, Mode=OneWay}" />

                        <!-- Облачная синхронизация -->
                        <StackPanel Spacing="8">
                            <ToggleSwitch Header="{x:Bind ViewModel.UiSettingsCloudSync, Mode=OneWay}" IsOn="{x:Bind ViewModel.SettingsCloudEnabled, Mode=TwoWay}" />

                            <Grid ColumnSpacing="8" Visibility="{x:Bind BoolToVis(ViewModel.SettingsCloudEnabled), Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    Grid.Column="0"
                                    PlaceholderText="Путь к облачной папке..."
                                    Text="{x:Bind ViewModel.SettingsCloudFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Button
                                    Grid.Column="1"
                                    Click="PickCloudFolder_Click"
                                    Content="Обзор..." />
                            </Grid>
                        </StackPanel>

                        <!-- Оформление STORM AURORA FLUID -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 9 Динамических тем -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.UiSettingsTheme, Mode=OneWay}" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.AvailableThemes}"
                                    SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- 13 Цветов акцентов -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.UiSettingsAccent, Mode=OneWay}" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.AvailableAccents}"
                                    SelectedItem="{x:Bind ViewModel.SelectedAccent, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 11 Языков интерфейса -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.UiSettingsLanguage, Mode=OneWay}" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.AvailableLanguages}"
                                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- 10 Динамических шрифтов -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.UiSettingsFont, Mode=OneWay}" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.AvailableFonts}"
                                    SelectedItem="{x:Bind ViewModel.SelectedFont, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <!-- Автоблокировка -->
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.UiSettingsAutoLock, Mode=OneWay}"
                                Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind AutoLockOptions}"
                                SelectedIndex="{x:Bind AutoLockIndex, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Windows Hello Биометрия -->
                        <ToggleSwitch
                            Header="{x:Bind ViewModel.UiWindowsHelloToggle, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsWindowsHelloAvailable, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.SettingsWindowsHelloEnabled, Mode=TwoWay}" />

                        <!-- Аудит скомпрометированных паролей (Have I Been Pwned) -->
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.UiAuditPasswords, Mode=OneWay}" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="{x:Bind ViewModel.CurrentTextSecondaryBrush, Mode=OneWay}" Text="{x:Bind ViewModel.AuditStatusText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.AuditAllPasswordsCommand}" IsEnabled="{x:Bind InvBool(ViewModel.IsAuditingPasswords), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                        <TextBlock Text="Проверить" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ProgressBar Value="{x:Bind ViewModel.AuditProgress, Mode=OneWay}" Maximum="100" Visibility="{x:Bind BoolToVis(ViewModel.IsAuditingPasswords), Mode=OneWay}" />
                        </StackPanel>

                        <!-- Смена мастер-пароля и резервное копирование -->
                        <Border
                            Padding="12"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Смена мастер-пароля и резервные копии (.bak1..3)" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox Grid.Column="0" PlaceholderText="Текущий пароль" Password="{x:Bind ViewModel.OldMasterPasswordInput, Mode=TwoWay}" />
                                    <PasswordBox Grid.Column="1" PlaceholderText="Новый (мин. 6 симв.)" Password="{x:Bind ViewModel.NewMasterPasswordInput, Mode=TwoWay}" />
                                    <Button Grid.Column="2" Command="{x:Bind ViewModel.ChangeMasterPasswordCommand}" Content="Сменить" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CreateBackupSnapshotCommand}" Content="Создать .bak копию" />
                                    <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="ExportRecoveryKit_Click" Content="Аварийный лист (.txt)" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Статус сертификата STORM -->
                        <Border
                            Padding="12"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Foreground="#107C41"
                                    Glyph="&#xE73E;" />
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="#107C41"
                                        Text="{x:Bind ViewModel.CertificateStatus, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Шифрование AES-256-GCM • Хеширование Argon2id • Экосистема STORM" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Автоматическое обновление (Auto-Update System) -->
                        <Border
                            Padding="12"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.UiUpdatesHeader, Mode=OneWay}" Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                        IsEnabled="{x:Bind Not(ViewModel.IsCheckingUpdate), Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE895;" />
                                            <TextBlock Text="{x:Bind ViewModel.UiCheckUpdates, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Кнопка Обновить ТОЛЬКО при реально доступной более новой версии -->
                                <StackPanel Spacing="6" Visibility="{x:Bind BoolToVis(ViewModel.IsUpdateAvailable), Mode=OneWay}">
                                    <Button
                                        MinWidth="140"
                                        Padding="16,8"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Command="{x:Bind ViewModel.InstallUpdateCommand}"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" />
                                            <TextBlock Text="Обновить" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Кнопки диалога -->
                        <Grid Margin="0,12,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                Command="{x:Bind ViewModel.SaveSettingsCommand}"
                                Foreground="#FFFFFF"
                                Content="{x:Bind ViewModel.UiSettingsSave, Mode=OneWay}" />

                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Click="CloseSettingsDialog_Click"
                                Content="{x:Bind ViewModel.UiSettingsClose, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ДИАЛОГ «О ПРОГРАММЕ» STORM KEYS (МОДАЛЬНЫЙ ОВЕРЛЕЙ) -->
        <Grid Background="#7F000000" Visibility="{x:Bind BoolToVis(ViewModel.IsAboutDialogVisible), Mode=OneWay}">
            <Border
                Width="480"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{x:Bind ViewModel.CurrentHeaderBrush, Mode=OneWay}"
                BorderBrush="{x:Bind ViewModel.CurrentCardStrokeBrush, Mode=OneWay}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Padding="32" Spacing="20">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <Grid Width="80" Height="80" HorizontalAlignment="Center">
                            <Border
                                Width="80"
                                Height="80"
                                CornerRadius="22"
                                Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                                Opacity="0.25" />
                            <Image
                                Width="72"
                                Height="72"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                                Stretch="UniformToFill" />
                        </Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}"
                            Text="{x:Bind ViewModel.UiAboutTitle, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.UiAboutVersion, Mode=OneWay}" />
                    </StackPanel>

                    <Border
                        Padding="16"
                        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="12"
                                LineHeight="18"
                                TextWrapping="Wrap"
                                Foreground="{x:Bind ViewModel.CurrentTextPrimaryBrush, Mode=OneWay}"
                                Text="{x:Bind ViewModel.UiAboutDesc, Mode=OneWay}" />

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe Fluent Icons" Foreground="#107C41" Glyph="&#xE73E;" FontSize="14" />
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#107C41"
                                    Text="{x:Bind ViewModel.UiAboutPublisher, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.UiAboutCert, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Button
                        HorizontalAlignment="Stretch"
                        Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                        Click="CloseAboutDialog_Click"
                        Foreground="#FFFFFF"
                        Content="{x:Bind ViewModel.UiAboutClose, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ЭКРАН БЛОКИРОВКИ / АВТОРИЗАЦИИ (ОВЕРЛЕЙ) -->
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="{x:Bind BoolToVis(ViewModel.IsVaultLocked), Mode=OneWay}">
            <Border
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Padding="36" Spacing="20">
                    <Grid Width="72" Height="72" HorizontalAlignment="Center">
                        <Border
                            Width="72"
                            Height="72"
                            CornerRadius="20"
                            Background="{x:Bind ViewModel.CurrentAccentBrush, Mode=OneWay}"
                            Opacity="0.25" />
                        <Image
                            Width="64"
                            Height="64"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                            Stretch="UniformToFill" />
                    </Grid>

                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="24"
                            FontWeight="Bold"
                            Text="STORM KEYS" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Защищенное хранилище ключей и паролей" />
                    </StackPanel>

                    <!-- Состояние: Первичная настройка (Задать пароль) -->
                    <StackPanel Spacing="12" Visibility="{x:Bind BoolToVis(ViewModel.IsVaultUninitialized), Mode=OneWay}">
                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="Задайте мастер-пароль для инициализации зашифрованного хранилища."
                            Severity="Informational" />

                        <PasswordBox
                            x:Name="NewMasterPasswordBox"
                            Header="Мастер-пароль (минимум 6 символов)"
                            Password="{x:Bind ViewModel.MasterPasswordInput, Mode=TwoWay}"
                            PlaceholderText="Придумайте надежный мастер-пароль" />

                        <PasswordBox
                            x:Name="ConfirmMasterPasswordBox"
                            Header="Подтвердите мастер-пароль"
                            Password="{x:Bind ViewModel.ConfirmPasswordInput, Mode=TwoWay}"
                            PlaceholderText="Повторите ввод мастер-пароля" />

                        <Button
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Command="{x:Bind ViewModel.UnlockOrCreateVaultCommand}"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                            <TextBlock FontWeight="SemiBold" Text="Создать хранилище" />
                        </Button>
                    </StackPanel>

                    <!-- Состояние: Разблокировка существующего хранилища -->
                    <StackPanel Spacing="14" Visibility="{x:Bind InvBoolToVis(ViewModel.IsVaultUninitialized), Mode=OneWay}">
                        <PasswordBox
                            x:Name="UnlockPasswordBox"
                            Header="Мастер-пароль"
                            KeyDown="UnlockPasswordBox_KeyDown"
                            Password="{x:Bind ViewModel.MasterPasswordInput, Mode=TwoWay}"
                            PlaceholderText="Введите мастер-пароль для доступа..." />

                        <Button
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Command="{x:Bind ViewModel.UnlockOrCreateVaultCommand}"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                            <TextBlock FontWeight="SemiBold" Text="Разблокировать хранилище" />
                        </Button>

                        <!-- Кнопка Windows Hello (биометрия / PIN) -->
                        <Button
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            Command="{x:Bind ViewModel.UnlockWithWindowsHelloCommand}"
                            Visibility="{x:Bind BoolToVis(ViewModel.IsWindowsHelloEnrolled), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xE8D7;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="16" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.UiWindowsHelloUnlock, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Ошибка мастер-пароля -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#D13438"
                        Text="{x:Bind ViewModel.MasterPasswordErrorMessage, Mode=OneWay}"
                        Visibility="{x:Bind StringToVis(ViewModel.MasterPasswordErrorMessage), Mode=OneWay}" />

                    <!-- Индикатор загрузки -->
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind BoolToVis(ViewModel.IsLoading), Mode=OneWay}" />

                    <!-- Защитный бейдж -->
                    <Border
                        Padding="8,4"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="AES-256-GCM • Argon2id KDF • STORM ECOSYSTEM" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
